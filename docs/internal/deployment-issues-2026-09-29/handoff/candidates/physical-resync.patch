+//! Draft strict storage hydration regressions; requires strict-storage-draft.patch.
+//! Closed private databases only. These tests do not prove live publication.
+use heliosdb_nano::{storage::StorageEngine, Config};
+use rocksdb::{Options, DB};
+use tempfile::TempDir;
+
+fn config() -> Config {
+    let mut config = Config::default();
+    config.storage.wal_enabled = false;
+    config.storage.elide_latest_version = false;
+    config
+}
+
+fn initialized() -> (TempDir, Config) {
+    let dir = TempDir::new().unwrap();
+    let cfg = config();
+    let storage = StorageEngine::open(dir.path(), &cfg).unwrap();
+    drop(storage);
+    (dir, cfg)
+}
+
+#[test]
+fn strict_snapshot_does_not_replay_wal_or_install_elision_or_write_on_close() {
+    let (dir, mut cfg) = initialized();
+    let raw = DB::open(&Options::default(), dir.path()).unwrap();
+    raw.put(
+        b"wal:entries:00000000000000000001",
+        b"deliberately invalid logical intent",
+    )
+    .unwrap();
+    raw.put(b"physical-test", b"authoritative physical bytes").unwrap();
+    let cut = raw.latest_sequence_number();
+    drop(raw);
+    cfg.storage.wal_enabled = true;
+    cfg.storage.elide_latest_version = true;
+    let storage = StorageEngine::open_physical_snapshot(dir.path(), &cfg).unwrap();
+    assert!(!storage.index_snapshots_on_close());
+    assert!(!storage.row_counter_flush_on_close());
+    assert!(!storage.wal_checkpoint_on_close());
+    assert_eq!(storage.db().latest_sequence_number(), cut);
+    assert_eq!(
+        storage.db().get(b"physical-test").unwrap().as_deref(),
+        Some(b"authoritative physical bytes".as_slice())
+    );
+    assert!(storage.db().get(b"w3_2_elide_used").unwrap().is_none());
+    assert!(storage.db().put(b"cannot-write", b"x").is_err());
+    drop(storage);
+    let raw = DB::open_for_read_only(&Options::default(), dir.path(), false).unwrap();
+    assert_eq!(raw.latest_sequence_number(), cut);
+    assert!(raw.get(b"wal:entries:00000000000000000001").unwrap().is_some());
+    assert!(raw.get(b"cannot-write").unwrap().is_none());
+}
+
+#[test]
+fn malformed_visibility_and_counter_records_refuse_strict_hydration() {
+    let records: &[(&[u8], &[u8])] = &[
+        (b"snapshot:1", b"broken"),
+        (b"vmeta:t:00000000000000000009:00000000000000000001", &[0; 8]),
+        (b"vgc:low_watermark", b"short"),
+        (b"w3_2_elide_used", &[2]),
+        (b"counter:\xff", &[0; 8]),
+    ];
+    for (key, value) in records {
+        let (dir, cfg) = initialized();
+        let raw = DB::open(&Options::default(), dir.path()).unwrap();
+        raw.put(key, value).unwrap();
+        let cut = raw.latest_sequence_number();
+        drop(raw);
+        assert!(
+            StorageEngine::open_physical_snapshot(dir.path(), &cfg).is_err(),
+            "accepted corrupt key {key:?}"
+        );
+        let raw = DB::open_for_read_only(&Options::default(), dir.path(), false).unwrap();
+        assert_eq!(raw.latest_sequence_number(), cut);
+        assert_eq!(raw.get(key).unwrap().as_deref(), Some(*value));
+    }
+}
+
+#[test]
+fn strict_metadata_scan_rejects_lossy_names() {
+    let (dir, cfg) = initialized();
+    let raw = DB::open(&Options::default(), dir.path()).unwrap();
+    raw.put(b"meta:test:\xff", b"value").unwrap();
+    drop(raw);
+    let storage = StorageEngine::open_physical_snapshot(dir.path(), &cfg).unwrap();
+    assert!(storage.meta_blobs_with_prefix_strict("meta:test:").is_err());
+}
+
+#[test]
+fn strict_branch_loader_never_creates_missing_registry() {
+    let dir = TempDir::new().unwrap();
+    let mut options = Options::default();
+    options.create_if_missing(true);
+    let raw = DB::open(&options, dir.path()).unwrap();
+    assert_eq!(raw.latest_sequence_number(), 0);
+    drop(raw);
+    assert!(StorageEngine::open_physical_snapshot(dir.path(), &config()).is_err());
+    let raw = DB::open_for_read_only(&Options::default(), dir.path(), false).unwrap();
+    assert_eq!(raw.latest_sequence_number(), 0);
+}
+
+#[test]
+fn ordinary_open_refuses_physical_receiver_cursor_before_logical_recovery() {
+    let (dir, cfg) = initialized();
+    let raw = DB::open(&Options::default(), dir.path()).unwrap();
+    raw.put(b"__nano_physical_replica_cursor_v1", b"reserved receiver metadata")
+        .unwrap();
+    let cut = raw.latest_sequence_number();
+    drop(raw);
+    assert!(StorageEngine::open(dir.path(), &cfg).is_err());
+    assert!(StorageEngine::open_read_only(dir.path(), &cfg).is_err());
+    let raw = DB::open_for_read_only(&Options::default(), dir.path(), false).unwrap();
+    assert_eq!(raw.latest_sequence_number(), cut);
+}
+
+#[test]
+fn physical_snapshot_requires_persistent_existing_storage() {
+    let dir = TempDir::new().unwrap();
+    let missing = dir.path().join("absent");
+    assert!(StorageEngine::open_physical_snapshot(&missing, &config()).is_err());
+    assert!(!missing.exists());
+    assert!(StorageEngine::open_physical_snapshot(dir.path(), &Config::in_memory()).is_err());
+}
+
+#[test]
+fn strict_open_on_an_existing_empty_directory_is_refused_without_mutation() {
+    // An existing-but-invalid (empty) checkpoint directory must be refused AND
+    // left untouched: strict hydration never initializes storage or writes files.
+    let dir = TempDir::new().unwrap();
+    let empty = dir.path().join("empty");
+    std::fs::create_dir(&empty).unwrap();
+    fn names(p: &std::path::Path) -> Vec<std::ffi::OsString> {
+        let mut v: Vec<_> = std::fs::read_dir(p).unwrap().map(|e| e.unwrap().file_name()).collect();
+        v.sort();
+        v
+    }
+    let before = names(&empty);
+    assert!(StorageEngine::open_physical_snapshot(&empty, &config()).is_err());
+    let after = names(&empty);
+    assert!(after.is_empty(), "strict open created files in an empty dir: {after:?}");
+    assert_eq!(before, after, "strict open mutated the directory");
+}
+
+#[cfg(unix)]
+#[test]
+fn physical_marker_symlink_refuses_before_creating_database_files() {
+    let dir = TempDir::new().unwrap();
+    std::os::unix::fs::symlink("missing", dir.path().join("NANO-PHYSICAL-REPLICA.json")).unwrap();
+    assert!(StorageEngine::open(dir.path(), &config()).is_err());
+    assert!(StorageEngine::open_read_only(dir.path(), &config()).is_err());
+    assert_eq!(std::fs::read_dir(dir.path()).unwrap().count(), 1);
+    assert!(!dir.path().join("CURRENT").exists());
+}
diff --git a/tests/raw_pk_owner_fallback.rs b/tests/raw_pk_owner_fallback.rs
new file mode 100644
index 0000000..3c9379e
--- /dev/null
+++ b/tests/raw_pk_owner_fallback.rs
@@ -0,0 +1,237 @@
+//! Supplemental external draft: a dishonest ART hit must not hide the actual
+//! stored owner of a scalar PK. This fixture deliberately misdirects a public
+//! ART handle; it does not claim that normal SQL produces that exact state.
+//! Public API only, private in-memory databases, no HA singleton/ports/files.
+//! No branch/composite/missing-schema policy is asserted here.
+
+use heliosdb_nano::{storage::ArtIndexManager, EmbeddedDatabase, Schema, Tuple, Value};
+use uuid::Uuid;
+
+const TABLE: &str = "pk_owner_fixture";
+const APIS: [&str; 6] = [
+    "get_row_by_pk",
+    "get_row_by_pk_with_schema",
+    "get_row_by_typed_pk_with_schema",
+    "get_row_by_typed_pk_with_schema_no_cache_fill",
+    "get_row_by_pk_for_write_with_schema",
+    "get_row_by_typed_pk_for_write_with_schema",
+];
+
+#[derive(Clone, Copy, Debug)]
+enum KeyKind {
+    Int,
+    BigInt,
+    Uuid,
+}
+
+struct Fixture {
+    db: EmbeddedDatabase,
+    schema: Schema,
+    owner: Tuple,
+    decoy: Tuple,
+    typed: Value,
+    literal: Value,
+}
+
+impl Fixture {
+    fn new(kind: KeyKind) -> Self {
+        let db = EmbeddedDatabase::new_in_memory().unwrap();
+        let (sql_type, owner_sql, decoy_sql, typed, literal) = match kind {
+            KeyKind::Int => ("INT", "11".into(), "22".into(), Value::Int4(11), Value::Int4(11)),
+            KeyKind::BigInt => ("BIGINT", "11".into(), "22".into(), Value::Int8(11), Value::Int4(11)),
+            KeyKind::Uuid => {
+                let owner = Uuid::parse_str("123e4567-e89b-12d3-a456-426614174011").unwrap();
+                let decoy = Uuid::parse_str("123e4567-e89b-12d3-a456-426614174022").unwrap();
+                (
+                    "UUID",
+                    format!("'{owner}'"),
+                    format!("'{decoy}'"),
+                    Value::Uuid(owner),
+                    Value::String(owner.to_string()),
+                )
+            }
+        };
+        // PK deliberately is NOT column zero; comparing the first value is wrong.
+        db.execute(&format!(
+            "CREATE TABLE {TABLE} (padding INT, id {sql_type} PRIMARY KEY, label TEXT)"
+        ))
+        .unwrap();
+        db.execute(&format!(
+            "INSERT INTO {TABLE} VALUES (101, {owner_sql}, 'actual-owner'), (202, {decoy_sql}, 'wrong-index-target')"
+        ))
+        .unwrap();
+        let schema = db.storage.catalog().get_table_schema(TABLE).unwrap();
+        assert!(schema.has_single_column_pk());
+        assert_eq!(schema.get_column_index("id"), Some(1));
+        // Derive expected IDs from row storage, independently of the PK lookup.
+        let rows = db.storage.scan_table_with_schema(TABLE, &schema).unwrap();
+        assert_eq!(rows.len(), 2);
+        let owner = rows
+            .iter()
+            .find(|row| row.values.get(1) == Some(&typed))
+            .unwrap()
+            .clone();
+        let decoy = rows
+            .iter()
+            .find(|row| row.values.get(1) != Some(&typed))
+            .unwrap()
+            .clone();
+        assert_eq!(
+            owner.values,
+            vec![Value::Int4(101), typed.clone(), Value::String("actual-owner".into())]
+        );
+        assert_eq!(decoy.values.first(), Some(&Value::Int4(202)));
+        assert_eq!(decoy.values.get(2), Some(&Value::String("wrong-index-target".into())));
+        assert!(owner.row_id.is_some());
+        assert!(decoy.row_id.is_some());
+        assert_ne!(owner.row_id, decoy.row_id);
+        assert!(
+            db.storage.row_cache().is_enabled(),
+            "warm-path coverage requires row cache"
+        );
+        Self {
+            db,
+            schema,
+            owner,
+            decoy,
+            typed,
+            literal,
+        }
+    }
+
+    fn lookup(&self, api: usize) -> heliosdb_nano::Result<Option<Tuple>> {
+        let storage = &self.db.storage;
+        match api {
+            0 => storage.get_row_by_pk(TABLE, &self.literal),
+            1 => storage.get_row_by_pk_with_schema(TABLE, &self.literal, &self.schema),
+            2 => storage.get_row_by_typed_pk_with_schema(TABLE, &self.typed, &self.schema),
+            3 => storage.get_row_by_typed_pk_with_schema_no_cache_fill(TABLE, &self.typed, &self.schema),
+            4 => storage.get_row_by_pk_for_write_with_schema(TABLE, &self.literal, &self.schema),
+            5 => storage.get_row_by_typed_pk_for_write_with_schema(TABLE, &self.typed, &self.schema),
+            _ => unreachable!(),
+        }
+    }
+
+    fn cache_state(&self, warm: bool) {
+        let cache = self.db.storage.row_cache();
+        cache.clear();
+        assert!(cache.is_empty());
+        if warm {
+            let decoy = self
+                .db
+                .storage
+                .get_row_by_id(TABLE, self.decoy.row_id.unwrap(), &self.schema)
+                .unwrap()
+                .unwrap();
+            assert_eq!(decoy.values, self.decoy.values);
+            assert_eq!(decoy.row_id, self.decoy.row_id);
+            assert_eq!(
+                cache.get(TABLE, self.decoy.row_id.unwrap()).unwrap().values,
+                self.decoy.values
+            );
+        }
+        assert!(cache.get(TABLE, self.owner.row_id.unwrap()).is_none());
+    }
+
+    fn misdirect(&self) {
+        let key = ArtIndexManager::encode_key(std::slice::from_ref(&self.typed));
+        let index = self.db.storage.art_indexes().get_pk_index(TABLE).unwrap();
+        {
+            let mut tree = index.write().unwrap();
+            assert_eq!(tree.remove(&key).unwrap(), self.owner.row_id);
+            tree.insert(&key, self.decoy.row_id.unwrap()).unwrap();
+        } // Release the ART lock BEFORE any lookup/scan under test.
+        assert_eq!(
+            self.db.storage.art_indexes().pk_index_lookup(TABLE, &key),
+            self.decoy.row_id
+        );
+        // Neither backing row changed when the index hint was redirected.
+        let rows = self.db.storage.scan_table_with_schema(TABLE, &self.schema).unwrap();
+        assert!(rows
+            .iter()
+            .any(|row| row.row_id == self.owner.row_id && row.values == self.owner.values));
+        assert!(rows
+            .iter()
+            .any(|row| row.row_id == self.decoy.row_id && row.values == self.decoy.values));
+    }
+}
+
+fn check_existing_owner(kind: KeyKind, warm: bool) {
+    let fixture = Fixture::new(kind);
+    // Honest-index control also proves literal BIGINT/UUID coercion works in
+    // the untyped APIs while typed APIs receive their exact declared variant.
+    for (api, name) in APIS.iter().enumerate() {
+        fixture.db.storage.row_cache().clear();
+        let actual = fixture
+            .lookup(api)
+            .unwrap()
+            .unwrap_or_else(|| panic!("honest control missed: {kind:?} {name}"));
+        assert_eq!(actual.values, fixture.owner.values, "honest control: {kind:?} {name}");
+        assert_eq!(
+            actual.row_id, fixture.owner.row_id,
+            "honest control ID: {kind:?} {name}"
+        );
+    }
+    fixture.misdirect();
+    let mut failures = Vec::new();
+    for (api, name) in APIS.iter().enumerate() {
+        fixture.cache_state(warm);
+        match fixture.lookup(api) {
+            Ok(Some(row)) if row.values == fixture.owner.values && row.row_id == fixture.owner.row_id => (),
+            outcome => failures.push(format!(
+                "{name}: expected true owner {:?}, got {outcome:?}",
+                fixture.owner
+            )),
+        }
+        // A fallback must not republish an index-derived tuple in row cache.
+        // A correctly cached old/decoy tuple remains valid for its OWN row ID.
+        let cache = fixture.db.storage.row_cache();
+        if cache.get(TABLE, fixture.owner.row_id.unwrap()).is_some() {
+            failures.push(format!("{name}: mismatch fallback admitted owner into row cache"));
+        }
+        let decoy_cached = cache.get(TABLE, fixture.decoy.row_id.unwrap());
+        if warm {
+            if !matches!(decoy_cached, Some(ref row) if row.values == fixture.decoy.values && row.row_id == fixture.decoy.row_id)
+            {
+                failures.push(format!("{name}: warm legitimate decoy cache entry changed"));
+            }
+        } else if decoy_cached.is_some() {
+            failures.push(format!("{name}: mismatch path filled cold cache with wrong target"));
+        }
+    }
+    assert!(
+        failures.is_empty(),
+        "kind={kind:?} warm={warm}:\n{}",
+        failures.join("\n")
+    );
+}
+
+#[test]
+fn misdirected_nonfirst_int_pk_returns_stored_owner_with_cold_cache() {
+    check_existing_owner(KeyKind::Int, false);
+}
+
+#[test]
+fn misdirected_nonfirst_int_pk_returns_stored_owner_with_warm_cache() {
+    check_existing_owner(KeyKind::Int, true);
+}
+
+#[test]
+fn misdirected_bigint_pk_preserves_literal_coercion_with_cold_cache() {
+    check_existing_owner(KeyKind::BigInt, false);
+}
+
+#[test]
+fn misdirected_bigint_pk_preserves_literal_coercion_with_warm_cache() {
+    check_existing_owner(KeyKind::BigInt, true);
+}
+
+#[test]
+fn misdirected_uuid_pk_preserves_literal_coercion_with_cold_cache() {
+    check_existing_owner(KeyKind::Uuid, false);
+}
+
+#[test]
+fn misdirected_uuid_pk_preserves_literal_coercion_with_warm_cache() {
+    check_existing_owner(KeyKind::Uuid, true);
+}
diff --git a/tests/replay_publication_window.rs b/tests/replay_publication_window.rs
new file mode 100644
index 0000000..aefafdb
--- /dev/null
+++ b/tests/replay_publication_window.rs
@@ -0,0 +1,307 @@
+//! External draft: public API schedule for PK/index-versus-row publication.
+//! No production hooks, source edits, global HA state, ports, or user data.
+//! SQL predicate integrity and raw storage lookup identity are separate verdicts.
+use heliosdb_nano::{
+    storage::{ArtIndexManager, WalOperation, WalSyncMode, WriteAheadLog},
+    Config, EmbeddedDatabase, Tuple, Value,
+};
+use std::{
+    sync::{mpsc, Arc},
+    thread,
+    time::{Duration, Instant},
+};
+
+const TABLE: &str = "replay_window";
+const SECONDARY: &str = "replay_window_blocker";
+const DEADLINE: Duration = Duration::from_secs(5);
+type Rows = Vec<Vec<i32>>;
+
+#[derive(Debug)]
+struct Probe {
+    requested_id: i32,
+    description: String,
+    result: Result<Rows, String>,
+}
+#[derive(Debug)]
+struct Observation {
+    from: i32,
+    to: i32,
+    boundary: &'static str,
+    raw_at_boundary: Result<Option<Tuple>, String>,
+    completed_while_blocker_held: bool,
+    sql: Vec<Probe>,
+    storage: Vec<Probe>,
+    writer: Result<(), String>,
+}
+
+fn db(initial_id: i32) -> Arc<EmbeddedDatabase> {
+    let mut config = Config::in_memory();
+    config.storage.wal_enabled = true;
+    config.storage.logical_wal_per_statement = true;
+    config.storage.wal_checkpoint_interval_entries = 0;
+    config.storage.wal_checkpoint_interval_secs = 0;
+    let db = Arc::new(EmbeddedDatabase::with_config(config).unwrap());
+    db.execute("CREATE TABLE replay_window (id INT PRIMARY KEY, v INT)")
+        .unwrap();
+    // Register separately AFTER the PK. table_index_add preserves insertion
+    // order; live replay therefore stages PK before attempting this tree lock.
+    db.execute("CREATE INDEX replay_window_blocker ON replay_window(v)")
+        .unwrap();
+    db.execute(&format!(
+        "INSERT INTO replay_window VALUES ({initial_id}, {})",
+        initial_id * 10
+    ))
+    .unwrap();
+    db
+}
+
+fn values(rows: Vec<Tuple>) -> Result<Rows, String> {
+    rows.into_iter()
+        .map(|row| {
+            row.values
+                .into_iter()
+                .map(|value| match value {
+                    Value::Int4(value) => Ok(value),
+                    other => Err(format!("fixture expected INT values, got {other:?}")),
+                })
+                .collect()
+        })
+        .collect()
+}
+
+fn captured_update(primary: &EmbeddedDatabase, from: i32, to: i32) -> (WalOperation, Vec<u8>) {
+    let before = primary.storage.wal_lsn().unwrap();
+    primary
+        .execute(&format!(
+            "UPDATE replay_window SET id = {to}, v = {} WHERE id = {from}",
+            to * 10
+        ))
+        .unwrap();
+    let reader = WriteAheadLog::open(primary.storage.db(), WalSyncMode::Async).unwrap();
+    let updates: Vec<_> = reader
+        .replay_from(before)
+        .unwrap()
+        .into_iter()
+        .filter_map(|entry| match entry.operation {
+            operation @ WalOperation::Update { .. } => Some(operation),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(
+        updates.len(),
+        1,
+        "fixture must capture one actual SQL UPDATE row record"
+    );
+    let operation = updates.into_iter().next().unwrap();
+    let key = match &operation {
+        WalOperation::Update { table, key, .. } => {
+            assert_eq!(table, TABLE);
+            key.clone()
+        }
+        _ => unreachable!(),
+    };
+    (operation, key)
+}
+
+fn boundary(from: i32, to: i32) -> Observation {
+    let primary = db(from);
+    let standby = db(from);
+    let (operation, storage_key) = captured_update(&primary, from, to);
+    let new_key = ArtIndexManager::encode_key(&[Value::Int4(to)]);
+    let old_key = ArtIndexManager::encode_key(&[Value::Int4(from)]);
+    let original_id = standby.storage.art_indexes().pk_index_lookup(TABLE, &old_key).unwrap();
+    assert_eq!(standby.storage.art_indexes().pk_index_lookup(TABLE, &new_key), None);
+    let secondary = standby.storage.art_indexes().get_index(SECONDARY).unwrap();
+    let blocker = secondary.write().unwrap();
+    let (writer_tx, writer_rx) = mpsc::channel();
+    let writer_storage = Arc::clone(&standby.storage);
+    let writer_handle = thread::spawn(move || {
+        let result = writer_storage
+            .apply_replicated_operation(operation)
+            .map_err(|error| error.to_string());
+        let _ = writer_tx.send(result);
+    });
+
+    // No assertions, early returns or joins while holding the blocker. On a
+    // baseline that performs raw puts only, the writer finishes without touching
+    // this lock. That path is observed separately, never called a staged window.
+    let deadline = Instant::now() + DEADLINE;
+    let mut writer_done = None;
+    let observed_boundary = loop {
+        if standby.storage.art_indexes().pk_index_lookup(TABLE, &new_key) == Some(original_id) {
+            break "new_pk_claim_visible_before_secondary";
+        }
+        match writer_rx.try_recv() {
+            Ok(result) => {
+                writer_done = Some(result);
+                break "writer_completed_without_new_pk_claim";
+            }
+            Err(mpsc::TryRecvError::Disconnected) => break "writer_disconnected",
+            Err(mpsc::TryRecvError::Empty) => (),
+        }
+        if Instant::now() >= deadline {
+            break "boundary_timeout";
+        }
+        thread::sleep(Duration::from_millis(1));
+    };
+    let raw_at_boundary = standby
+        .storage
+        .get(&storage_key)
+        .map_err(|error| error.to_string())
+        .and_then(|raw| {
+            raw.map(|bytes| bincode::deserialize::<Tuple>(&bytes).map_err(|error| error.to_string()))
+                .transpose()
+        });
+    let (reader_tx, reader_rx) = mpsc::channel();
+    let reader_db = Arc::clone(&standby);
+    let reader_handle = thread::spawn(move || {
+        let mut sql = Vec::new();
+        for requested_id in [to, from] {
+            // The existing fast-row PK predicate check is load-bearing. Test
+            // both the SELECT * fast shape and an explicit projection/fallback.
+            for projection in ["*", "id, v"] {
+                let text = format!("SELECT {projection} FROM replay_window WHERE id = {requested_id}");
+                let result = reader_db
+                    .query(&text, &[])
+                    .map_err(|error| error.to_string())
+                    .and_then(values);
+                sql.push(Probe {
+                    requested_id,
+                    description: text,
+                    result,
+                });
+            }
+        }
+        // Run raw storage probes AFTER SQL, so their cache fills cannot create
+        // the SQL symptom being investigated. Their own identity contract gets
+        // a separate assertion/test; no SQL failure is inferred from these rows.
+        let mut storage = Vec::new();
+        for requested_id in [to, from] {
+            let result = reader_db
+                .storage
+                .get_row_by_pk(TABLE, &Value::Int4(requested_id))
+                .map_err(|error| error.to_string())
+                .and_then(|row| values(row.into_iter().collect()));
+            storage.push(Probe {
+                requested_id,
+                description: "StorageEngine::get_row_by_pk".into(),
+                result,
+            });
+        }
+        let _ = reader_tx.send((sql, storage));
+    });
+    let while_held = reader_rx.recv_timeout(DEADLINE);
+    let completed_while_blocker_held = while_held.is_ok();
+
+    // ALWAYS release the writer's secondary tree before joining either thread.
+    // A SQL fallback may itself need that tree; a timeout is an inconclusive
+    // schedule and remains a test failure, not a hidden post-commit observation.
+    drop(blocker);
+    let (sql, storage) = match while_held {
+        Ok(probes) => probes,
+        Err(_) => reader_rx
+            .recv_timeout(DEADLINE)
+            .expect("reader did not finish after blocker release"),
+    };
+    let writer = writer_done.unwrap_or_else(|| {
+        writer_rx
+            .recv_timeout(DEADLINE)
+            .expect("writer did not finish after blocker release")
+    });
+    // Completion messages prove the workers have finished their storage/query
+    // operations. Shared engines remain owned here while worker handles return.
+    reader_handle.join().expect("reader panicked");
+    writer_handle.join().expect("writer panicked");
+    Observation {
+        from,
+        to,
+        boundary: observed_boundary,
+        raw_at_boundary,
+        completed_while_blocker_held,
+        sql,
+        storage,
+        writer,
+    }
+}
+
+fn violations(probes: &[Probe]) -> Vec<String> {
+    let mut failures = Vec::new();
+    for probe in probes {
+        match &probe.result {
+            Ok(rows) => {
+                for row in rows {
+                    if row != &vec![probe.requested_id, probe.requested_id * 10] {
+                        failures.push(format!(
+                            "{} requested id {} but returned {row:?}",
+                            probe.description, probe.requested_id
+                        ));
+                    }
+                }
+            }
+            Err(error) => failures.push(format!("{}: {error}", probe.description)),
+        }
+    }
+    failures
+}
+
+fn observations() -> Vec<Observation> {
+    // Independent fixtures in both directions avoid assuming that a known-bad
+    // baseline repaired its indexes sufficiently to prepare the next toggle.
+    [(1, 2), (2, 1)]
+        .into_iter()
+        .map(|(from, to)| boundary(from, to))
+        .collect()
+}
+
+fn assert_schedule(observation: &Observation) {
+    assert!(observation.writer.is_ok(), "{observation:#?}");
+    assert!(
+        observation.completed_while_blocker_held,
+        "SQL probe could not run at the intended boundary: {observation:#?}"
+    );
+    assert!(
+        matches!(
+            observation.boundary,
+            "new_pk_claim_visible_before_secondary" | "writer_completed_without_new_pk_claim"
+        ),
+        "{observation:#?}"
+    );
+    let raw = observation.raw_at_boundary.as_ref().unwrap().as_ref().unwrap();
+    let expected_id = if observation.boundary == "new_pk_claim_visible_before_secondary" {
+        observation.from
+    } else {
+        observation.to
+    };
+    assert_eq!(
+        raw.values,
+        vec![Value::Int4(expected_id), Value::Int4(expected_id * 10)],
+        "boundary must be the old row during a staged claim, or the new row after baseline completion"
+    );
+}
+
+#[test]
+fn sql_pk_predicates_hold_during_live_replay_publication() {
+    let observations = observations();
+    let mut failures = Vec::new();
+    for observation in &observations {
+        eprintln!("SQL AND STORAGE PUBLICATION OBSERVATION: {observation:#?}");
+        assert_schedule(observation);
+        failures.extend(violations(&observation.sql));
+    }
+    assert!(failures.is_empty(), "SQL predicate violations: {failures:#?}");
+}
+
+#[test]
+fn storage_pk_lookup_returns_only_the_requested_identity_during_live_replay_publication() {
+    let observations = observations();
+    let mut failures = Vec::new();
+    for observation in &observations {
+        eprintln!("RAW STORAGE PUBLICATION OBSERVATION: {observation:#?}");
+        assert_schedule(observation);
+        failures.extend(violations(&observation.storage));
+    }
+    assert!(
+        failures.is_empty(),
+        "raw storage PK identity violations (separate from SQL): {failures:#?}"
+    );
+}
diff --git a/tests/replay_storage_boundaries.rs b/tests/replay_storage_boundaries.rs
