+fn resolve_http_address(value: &str, port: Option<u16>) -> Result<Option<std::net::SocketAddr>> {
+    // Explicit disable wins even over an invalid or port-bearing address.
+    if port == Some(0) {
+        return Ok(None);
+    }
+    let address = parse_listen_address(value, port, 8080)?;
+    if address.port() == 0 {
+        return Ok(None);
+    }
+    Ok(Some(address))
+}
