+                } else {
+                    tree.get_all(&change.key).contains(&change.row_id)
+                };
+                if present {
+                    Ok(())
+                } else {
+                    tree.insert(&change.key, change.row_id).map(|()| {
+                        if let Some((value, width)) = change.dense_int {
+                            tree.record_dense_int_insert(width, value);
+                        }
+                    })
+                }
+            } else if change.unique {
