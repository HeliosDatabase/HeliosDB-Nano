+            config.max_chunk_bytes = value;
+        }
+        if let Some(value) = self.physical_frame_timeout_secs {
+            config.frame_timeout_secs = value;
+        }
+        if let Some(value) = self.physical_operation_timeout_secs {
+            config.operation_timeout_secs = value;
+        }
+    }
