+#[cfg(feature = "ha-tier1")]
+impl Drop for HAHandles {
+    fn drop(&mut self) {
+        // Also cover a later startup validation error before the serving select.
+        if let Some(handle) = &self.replication_handle {
+            handle.abort();
+        }
+        if let Some(handle) = &self.forwarding_handle {
+            handle.abort();
+        }
+    }
