+fn daemon_readiness_timeout(role: &str, replication_startup_secs: u64) -> std::time::Duration {
+    std::time::Duration::from_secs(if role.eq_ignore_ascii_case("standby") {
+        replication_startup_secs.saturating_add(5)
+    } else {
+        5
+    })
