+    }
+
+    #[test]
+    fn in_memory_binding_is_per_instance_and_immutable() {
+        let first = ReceiverHistory::in_memory();
+        let second = ReceiverHistory::in_memory();
+        let history_a = Uuid::new_v4();
+        let history_b = Uuid::new_v4();
