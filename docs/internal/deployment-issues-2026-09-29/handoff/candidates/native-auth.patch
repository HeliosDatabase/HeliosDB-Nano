diff --git a/tests/native_replication_auth.rs b/tests/native_replication_auth.rs
new file mode 100644
index 0000000..5c5bfc9
--- /dev/null
+++ b/tests/native_replication_auth.rs
@@ -0,0 +1,357 @@
+//! Native logical replication credential validation (archive issue 1).
+//!
+//! A primary configured with a credential MUST reject a standby handshake
+//! BEFORE any registration or WAL streaming:
+//!   * valid token   -> accepted and registered
+//!   * wrong token    -> rejected (`authentication failed`), nothing registered
+//!   * missing token  -> rejected (`authentication required`), nothing registered
+//! With no credential configured, the historical metadata-only handshake is
+//! preserved.
+
+#![cfg(feature = "ha-tier1")]
+
+use heliosdb_nano::replication::{
+    streaming::{StreamingServer, StreamingServerConfig},
+    transport::{Capabilities, HandshakeRequest, NodeRole, ReplicationAuth, ReplicationConnection, SyncModeConfig},
+    wal_store::{WalStore, WalStoreConfig},
+};
+use std::{net::SocketAddr, sync::Arc, time::Duration};
+use tokio::time::timeout;
+use uuid::Uuid;
+
+/// The HA broadcast channel is process-global; tests that create a server or
+/// broadcast WAL must not overlap.
+static SERIAL: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
+
+struct Harness {
+    addr: SocketAddr,
+    server: Arc<StreamingServer>,
+    task: tokio::task::JoinHandle<heliosdb_nano::replication::Result<()>>,
+    wal_store: Arc<WalStore>,
+    _dir: tempfile::TempDir,
+}
+
+async fn start_server(auth: Option<&str>) -> Harness {
+    let dir = tempfile::tempdir().unwrap();
+    let wal_store = Arc::new(WalStore::new(WalStoreConfig {
+        wal_dir: dir.path().join("wal"),
+        ..Default::default()
+    }));
+    wal_store.init().await.unwrap();
+    let server = Arc::new(StreamingServer::new(
+        StreamingServerConfig {
+            listen_addr: "127.0.0.1:0".parse().unwrap(),
+            auth: auth.map(|token| ReplicationAuth::SharedSecret { token: token.to_string() }),
+            ..Default::default()
+        },
+        Uuid::new_v4(),
+        wal_store.clone(),
+    ));
+    let listener = server.bind_listener().await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let task = {
+        let server = server.clone();
+        tokio::spawn(async move { server.start_with_listener(listener).await })
+    };
+    Harness {
+        addr,
+        server,
+        task,
+        wal_store,
+        _dir: dir,
+    }
+}
+
+fn request(auth: Option<&str>) -> HandshakeRequest {
+    HandshakeRequest {
+        node_id: Uuid::new_v4(),
+        role: NodeRole::Standby,
+        sync_mode: SyncModeConfig::Async,
+        current_lsn: Some(0),
+        slot_name: None,
+        capabilities: Capabilities::all(),
+        auth: auth.map(|token| ReplicationAuth::SharedSecret { token: token.to_string() }),
+    }
+}
+
+async fn connect(addr: SocketAddr) -> ReplicationConnection {
+    ReplicationConnection::connect(addr, Duration::from_secs(3))
+        .await
+        .unwrap()
+}
+
+async fn standby_count_settled(server: &StreamingServer, want: usize) -> usize {
+    let mut seen = 0;
+    for _ in 0..50 {
+        seen = server.connected_standby_count().await;
+        if seen == want {
+            return seen;
+        }
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    seen
+}
+
+/// Stop the server and PROVE every owned task ends before the temp dir is dropped.
+/// A timed-out join is aborted and awaited (never detached), and the timeout is
+/// asserted rather than swallowed.
+async fn stop(h: Harness) {
+    h.server.shutdown();
+    let mut task = h.task;
+    match timeout(Duration::from_secs(5), &mut task).await {
+        Ok(joined) => {
+            joined
+                .expect("server task panicked")
+                .expect("server task returned an error");
+        }
+        Err(_) => {
+            task.abort();
+            let _ = task.await;
+            panic!("server task did not stop within timeout; owned tasks were still running");
+        }
+    }
+    h.wal_store.close().await.expect("wal store close failed");
+    // h._dir (TempDir) drops here, after the task is joined.
+}
+
+#[tokio::test]
+async fn configured_credential_accepts_correct_token_and_registers() {
+    let _serial = SERIAL.lock().await;
+    let h = start_server(Some("s3cret-token")).await;
+    let mut conn = connect(h.addr).await;
+    let response = timeout(
+        Duration::from_secs(3),
+        conn.handshake_client(request(Some("s3cret-token"))),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert!(response.accepted, "correct credential must be accepted");
+    assert_eq!(
+        standby_count_settled(&h.server, 1).await,
+        1,
+        "authenticated standby must be registered"
+    );
+    let _ = conn.close().await;
+    stop(h).await;
+}
+
+#[tokio::test]
+async fn configured_credential_rejects_wrong_token_before_registration() {
+    let _serial = SERIAL.lock().await;
+    let h = start_server(Some("s3cret-token")).await;
+    let mut conn = connect(h.addr).await;
+    let error = timeout(
+        Duration::from_secs(3),
+        conn.handshake_client(request(Some("not-the-token"))),
+    )
+    .await
+    .unwrap()
+    .unwrap_err()
+    .to_string();
+    assert!(error.contains("authentication failed"), "{error}");
+    assert_never_registered_and_closed(&h.server, conn).await;
+    stop(h).await;
+}
+
+/// A rejected handshake must (a) never register a standby across a real window,
+/// and (b) close the socket so no further native frame can be requested. A single
+/// immediate count poll is not sufficient evidence of "never registered".
+async fn assert_never_registered_and_closed(server: &StreamingServer, mut conn: ReplicationConnection) {
+    let mut max_seen = 0;
+    for _ in 0..25 {
+        max_seen = max_seen.max(server.connected_standby_count().await);
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    assert_eq!(max_seen, 0, "a rejected credential must never register a standby");
+    let closed = match timeout(Duration::from_secs(2), conn.recv()).await {
+        Ok(Ok(_)) => false,  // server kept serving native frames after rejection
+        Ok(Err(_)) => true,  // socket closed/reset
+        Err(_) => false,     // still open and silently waiting
+    };
+    assert!(closed, "rejected connection was not closed by the server");
+}
+
+#[tokio::test]
+async fn configured_credential_rejects_missing_token_before_registration() {
+    let _serial = SERIAL.lock().await;
+    let h = start_server(Some("s3cret-token")).await;
+    let mut conn = connect(h.addr).await;
+    let error = timeout(Duration::from_secs(3), conn.handshake_client(request(None)))
+        .await
+        .unwrap()
+        .unwrap_err()
+        .to_string();
+    assert!(error.contains("authentication required"), "{error}");
+    assert_never_registered_and_closed(&h.server, conn).await;
+    stop(h).await;
+}
+
+#[tokio::test]
+async fn old_protocol_version_is_refused_before_registration() {
+    let _serial = SERIAL.lock().await;
+    // A raw OLD-layout peer (native protocol v1) must be refused explicitly by
+    // the version gate BEFORE any decode/registration, never silently accepted.
+    use heliosdb_nano::replication::transport::{Message, MessageType};
+    let h = start_server(None).await;
+    let payload = bincode::serialize(&request(None)).expect("serialize handshake");
+    let mut msg = Message::new(MessageType::HandshakeRequest, bytes::Bytes::from(payload), 1);
+    msg.header.version = 1; // simulate a v1 peer
+    let mut stream = tokio::net::TcpStream::connect(h.addr).await.expect("connect");
+    msg.write_to(&mut stream).await.expect("write v1 handshake");
+    let response = timeout(Duration::from_secs(3), Message::read_from(&mut stream))
+        .await
+        .expect("response timeout")
+        .expect("read response");
+    assert_eq!(response.header.msg_type, MessageType::HandshakeResponse);
+    let rejected: heliosdb_nano::replication::transport::HandshakeResponse =
+        bincode::deserialize(&response.payload).expect("decode response");
+    assert!(!rejected.accepted, "v1 handshake must be refused");
+    assert!(
+        rejected.error.unwrap_or_default().contains("version mismatch"),
+        "refusal must name the version mismatch"
+    );
+    let mut max_seen = 0;
+    for _ in 0..20 {
+        max_seen = max_seen.max(h.server.connected_standby_count().await);
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    assert_eq!(max_seen, 0, "a version-mismatched peer must never register");
+    stop(h).await;
+}
+
+#[tokio::test]
+async fn unconfigured_primary_preserves_metadata_only_handshake() {
+    let _serial = SERIAL.lock().await;
+    let h = start_server(None).await;
+    let mut conn = connect(h.addr).await;
+    let response = timeout(Duration::from_secs(3), conn.handshake_client(request(None)))
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(response.accepted, "no configured credential preserves legacy handshake");
+    let _ = conn.close().await;
+    stop(h).await;
+}
+
+#[tokio::test]
+async fn authenticated_connection_receives_broadcast_wal_entry() {
+    use heliosdb_nano::replication::ha_state::ha_state;
+    use heliosdb_nano::replication::transport::{MessageType, WalEntryPayload};
+    use heliosdb_nano::replication::wal_replicator::{WalEntry, WalEntryType};
+    let _serial = SERIAL.lock().await;
+    let h = start_server(Some("s3cret-token")).await;
+    let mut conn = connect(h.addr).await;
+    let response = timeout(Duration::from_secs(3), conn.handshake_client(request(Some("s3cret-token"))))
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(response.accepted);
+    assert_eq!(standby_count_settled(&h.server, 1).await, 1);
+    let entry = WalEntry {
+        lsn: 42,
+        tx_id: None,
+        entry_type: WalEntryType::Insert,
+        data: b"wal-socket-control".to_vec(),
+        checksum: 0,
+    };
+    let mut sent = false;
+    for _ in 0..50 {
+        if ha_state().broadcast_wal_entry(entry.clone()).is_some() {
+            sent = true;
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    assert!(sent, "no HA broadcast channel to deliver a WAL entry");
+    let mut received = None;
+    for _ in 0..50 {
+        match timeout(Duration::from_millis(200), conn.recv()).await {
+            Ok(Ok(msg)) if msg.header.msg_type == MessageType::WalEntry => {
+                received = Some(msg);
+                break;
+            }
+            Ok(Ok(_)) => continue,
+            Ok(Err(_)) => break,
+            Err(_) => continue,
+        }
+    }
+    let msg = received.expect("authenticated standby did not receive the broadcast WAL entry");
+    let payload: WalEntryPayload = bincode::deserialize(&msg.payload).expect("decode WAL payload");
+    assert_eq!(payload.lsn, 42, "wrong WAL entry LSN");
+    assert_eq!(payload.data, b"wal-socket-control", "wrong WAL entry contents");
+    stop(h).await;
+}
+
+#[tokio::test]
+async fn reconnect_with_the_same_credential_is_accepted() {
+    let _serial = SERIAL.lock().await;
+    let h = start_server(Some("s3cret-token")).await;
+    for attempt in 0..2 {
+        let mut conn = connect(h.addr).await;
+        let response = timeout(Duration::from_secs(3), conn.handshake_client(request(Some("s3cret-token"))))
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(response.accepted, "reconnect {attempt} with the same credential must be accepted");
+        let _ = conn.close().await;
+    }
+    stop(h).await;
+}
+
+#[tokio::test]
+async fn malformed_handshake_frame_is_refused_without_registration() {
+    use heliosdb_nano::replication::transport::{Message, MessageType};
+    let _serial = SERIAL.lock().await;
+    let h = start_server(None).await;
+    let msg = Message::new(MessageType::HandshakeRequest, bytes::Bytes::from_static(b"not-a-bincode-handshake"), 1);
+    let mut stream = tokio::net::TcpStream::connect(h.addr).await.expect("connect");
+    msg.write_to(&mut stream).await.expect("write malformed frame");
+    let closed = match timeout(Duration::from_secs(2), Message::read_from(&mut stream)).await {
+        Ok(Ok(_)) => false,
+        Ok(Err(_)) => true,
+        Err(_) => false,
+    };
+    assert!(closed, "malformed handshake did not close the connection");
+    let mut max_seen = 0;
+    for _ in 0..20 {
+        max_seen = max_seen.max(h.server.connected_standby_count().await);
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    assert_eq!(max_seen, 0, "malformed handshake must never register");
+    stop(h).await;
+}
+
+#[tokio::test]
+async fn new_client_refuses_an_old_version_server() {
+    use heliosdb_nano::replication::transport::{HandshakeResponse, Message, MessageType};
+    let _serial = SERIAL.lock().await;
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move {
+        let (mut stream, _) = listener.accept().await.unwrap();
+        let _request = Message::read_from(&mut stream).await.unwrap();
+        let response = HandshakeResponse {
+            accepted: true,
+            server_node_id: Uuid::new_v4(),
+            sync_mode: SyncModeConfig::Async,
+            primary_lsn: 0,
+            slot_name: None,
+            fencing_token: 1,
+            capabilities: Capabilities::all(),
+            error: None,
+        };
+        let payload = bincode::serialize(&response).unwrap();
+        let mut msg = Message::new(MessageType::HandshakeResponse, bytes::Bytes::from(payload), 1);
+        msg.header.version = 1; // simulate an old (v1) server
+        msg.write_to(&mut stream).await.unwrap();
+    });
+    let mut conn = connect(addr).await;
+    let error = timeout(Duration::from_secs(3), conn.handshake_client(request(None)))
+        .await
+        .unwrap()
+        .unwrap_err()
+        .to_string();
+    assert!(error.contains("version mismatch"), "new client must refuse an old server: {error}");
+    server.await.unwrap();
+}
diff --git a/tests/offline_reseed_tests.rs b/tests/offline_reseed_tests.rs
new file mode 100644
index 0000000..1bfb685
--- /dev/null
+++ b/tests/offline_reseed_tests.rs
@@ -0,0 +1,81 @@
+//! Actual Nano/RocksDB contract for the offline physical snapshot helper.
+//! This deliberately makes no online replication continuation claim.
+#![cfg(target_os = "linux")]
+
+use heliosdb_nano::{EmbeddedDatabase, Value};
+use std::path::Path;
+use std::process::{Command, Output};
+
+fn assert_seed_rows(db: &EmbeddedDatabase, expected: &[(i64, &str)]) {
+    let rows = db
+        .query("SELECT id, label FROM seed_data ORDER BY id", &[])
+        .expect("read seed rows");
+    assert_eq!(rows.len(), expected.len(), "snapshot row cardinality");
+    for (row, (id, label)) in rows.iter().zip(expected) {
+        let actual_id = match row.get(0) {
+            Some(Value::Int4(value)) => i64::from(*value),
+            Some(Value::Int8(value)) => *value,
+            other => panic!("unexpected seed ID: {other:?}"),
+        };
+        assert_eq!(actual_id, *id);
+        assert_eq!(row.get(1), Some(&Value::String((*label).to_string())));
+    }
+}
+
+fn copy_offline(source: &Path, target: &Path) -> Output {
+    Command::new("python3")
+        .arg(concat!(env!("CARGO_MANIFEST_DIR"), "/scripts/nano-offline-reseed.py"))
+        .arg("--source")
+        .arg(source)
+        .arg("--target")
+        .arg(target)
+        .arg("--confirm-offline")
+        .output()
+        .expect("run offline reseed helper")
+}
+
+#[test]
+fn offline_reseed_refuses_a_live_nano_directory() {
+    let temp = tempfile::tempdir().expect("fixture");
+    let source = temp.path().join("primary");
+    let target = temp.path().join("snapshot");
+    let db = EmbeddedDatabase::new(&source).expect("open primary");
+    db.execute("CREATE TABLE seed_lock (id INT PRIMARY KEY)")
+        .expect("schema");
+    let output = copy_offline(&source, &target);
+    assert!(!output.status.success());
+    assert!(String::from_utf8_lossy(&output.stderr).contains("source is open by another process"));
+    assert!(!target.exists());
+    db.execute("INSERT INTO seed_lock VALUES (1)")
+        .expect("source stays usable");
+}
+
+#[test]
+fn offline_reseed_preserves_rows_indexes_and_independent_storage() {
+    let temp = tempfile::tempdir().expect("fixture");
+    let source = temp.path().join("primary");
+    let target = temp.path().join("snapshot");
+    {
+        let db = EmbeddedDatabase::new(&source).expect("open primary");
+        db.execute("CREATE TABLE seed_data (id INT PRIMARY KEY, label TEXT UNIQUE)")
+            .expect("schema");
+        db.execute("INSERT INTO seed_data VALUES (1, 'first'), (2, 'second')")
+            .expect("rows");
+        db.flush().expect("flush");
+    }
+    let output = copy_offline(&source, &target);
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    {
+        let copy = EmbeddedDatabase::new(&target).expect("snapshot opens");
+        assert_seed_rows(&copy, &[(1, "first"), (2, "second")]);
+        assert!(copy.execute("INSERT INTO seed_data VALUES (3, 'first')").is_err());
+        copy.execute("INSERT INTO seed_data VALUES (3, 'third')")
+            .expect("row counter/index state supports new writes");
+        assert_seed_rows(&copy, &[(1, "first"), (2, "second"), (3, "third")]);
+    }
+    let original = EmbeddedDatabase::new(&source).expect("source reopens");
+    assert_seed_rows(&original, &[(1, "first"), (2, "second")]);
+    let rejected = copy_offline(&source, &target);
+    assert!(!rejected.status.success());
+    assert!(String::from_utf8_lossy(&rejected.stderr).contains("target already exists"));
+}
diff --git a/tests/replication_listener_startup.rs b/tests/replication_listener_startup.rs
new file mode 100644
index 0000000..a9457c6
--- /dev/null
+++ b/tests/replication_listener_startup.rs
@@ -0,0 +1,115 @@
+//! Native replication must reserve its endpoint before startup is advertised.
+
+#![cfg(feature = "ha-tier1")]
+
+use heliosdb_nano::replication::{
+    streaming::{StreamingServer, StreamingServerConfig},
+    transport::{
+        Capabilities, HandshakeRequest, Message, MessageType, NodeRole, ReplicationConnection, SyncModeConfig,
+    },
+    wal_store::{WalStore, WalStoreConfig},
+};
+use std::{sync::Arc, time::Duration};
+use tokio::{net::TcpListener, time::timeout};
+use uuid::Uuid;
+
+#[tokio::test]
+async fn occupied_endpoint_fails_before_serving_and_prebound_listener_handshakes() {
+    let occupied = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let occupied_addr = occupied.local_addr().unwrap();
+    let dir = tempfile::tempdir().unwrap();
+    let wal_store = Arc::new(WalStore::new(WalStoreConfig {
+        wal_dir: dir.path().join("wal"),
+        ..Default::default()
+    }));
+    wal_store.init().await.unwrap();
+    let blocked_server = StreamingServer::new(
+        StreamingServerConfig {
+            listen_addr: occupied_addr,
+            ..Default::default()
+        },
+        Uuid::new_v4(),
+        wal_store.clone(),
+    );
+    let error = blocked_server.bind_listener().await.unwrap_err().to_string();
+    assert!(error.contains(&occupied_addr.to_string()), "{error}");
+    assert!(error.contains("native replication listener"), "{error}");
+    assert!(error.contains("--replication-port"), "{error}");
+
+    let node_id = Uuid::new_v4();
+    let server = Arc::new(StreamingServer::new(
+        StreamingServerConfig {
+            listen_addr: "127.0.0.1:0".parse().unwrap(),
+            ..Default::default()
+        },
+        node_id,
+        wal_store.clone(),
+    ));
+    let listener = server.bind_listener().await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    assert!(TcpListener::bind(addr).await.is_err());
+    let server_task = {
+        let server = server.clone();
+        tokio::spawn(async move { server.start_with_listener(listener).await })
+    };
+    let mut connection = ReplicationConnection::connect(addr, Duration::from_secs(3))
+        .await
+        .unwrap();
+    let response = timeout(
+        Duration::from_secs(3),
+        connection.handshake_client(HandshakeRequest {
+            node_id: Uuid::new_v4(),
+            role: NodeRole::Standby,
+            sync_mode: SyncModeConfig::Async,
+            current_lsn: Some(0),
+            slot_name: None,
+            capabilities: Capabilities::all(),
+            auth: None,
+        }),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert!(response.accepted);
+    assert_eq!(response.server_node_id, node_id);
+    connection.close().await.unwrap();
+    server.shutdown();
+    timeout(Duration::from_secs(3), server_task)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    wal_store.close().await.unwrap();
+}
+
+#[tokio::test]
+async fn postgres_endpoint_response_has_actionable_protocol_diagnostic() {
+    // A PostgreSQL ErrorResponse with a severity and a message, not a HELI frame.
+    let fields = b"SFATAL\0Munsupported frontend protocol\0\0";
+    let mut frame = vec![b'E'];
+    frame.extend_from_slice(&((fields.len() + 4) as u32).to_be_bytes());
+    frame.extend_from_slice(fields);
+    let error = Message::read_from(&mut frame.as_slice()).await.unwrap_err().to_string();
+    assert!(error.contains("got 45000000"), "{error}");
+    assert!(error.contains("PostgreSQL ErrorResponse"), "{error}");
+    assert!(error.contains("--primary-host"), "{error}");
+    assert!(error.contains("--replication-port"), "{error}");
+}
+
+#[tokio::test]
+async fn native_protocol_still_roundtrips_and_other_magic_is_rejected() {
+    let original = Message::new(MessageType::Heartbeat, bytes::Bytes::from_static(b"payload"), 42);
+    let encoded = original.encode();
+    let decoded = Message::read_from(&mut encoded.as_ref()).await.unwrap();
+    assert_eq!(decoded.header.sequence, 42);
+    assert_eq!(decoded.payload, original.payload);
+
+    let mut corrupt = encoded.to_vec();
+    corrupt[..4].copy_from_slice(b"HTTP");
+    let error = Message::read_from(&mut corrupt.as_slice())
+        .await
+        .unwrap_err()
+        .to_string();
+    assert!(error.contains("native HELI replication protocol"), "{error}");
+    assert!(!error.contains("PostgreSQL ErrorResponse"), "{error}");
+}
diff --git a/tests/wal_applicator_fail_closed.rs b/tests/wal_applicator_fail_closed.rs
new file mode 100644
index 0000000..e250bfa
--- /dev/null
+++ b/tests/wal_applicator_fail_closed.rs
@@ -0,0 +1,160 @@
+//! A rejected WAL entry is a terminal gap, never permission to apply later LSNs.
+#![cfg(feature = "ha-tier1")]
+
+use heliosdb_nano::{
+    replication::{
+        config::PrimaryConfig,
+        wal_applicator::{ApplicatorState, WalApplicator},
+        wal_replicator::{WalEntry, WalEntryType},
+    },
+    storage::{WalOperation, WalSyncMode, WriteAheadLog},
+    Config, EmbeddedDatabase,
+};
+use std::time::Duration;
+use tokio::time::timeout;
+
+fn database() -> EmbeddedDatabase {
+    let mut config = Config::in_memory();
+    config.storage.wal_enabled = true;
+    config.storage.logical_wal_per_statement = true;
+    config.storage.wal_checkpoint_interval_entries = 0;
+    config.storage.wal_checkpoint_interval_secs = 0;
+    let db = EmbeddedDatabase::with_config(config).unwrap();
+    db.execute("CREATE TABLE applicator_rows (id INT PRIMARY KEY, v INT)")
+        .unwrap();
+    db
+}
+
+fn capture_insert(primary: &EmbeddedDatabase, id: i32) -> WalOperation {
+    let before = primary.storage.wal_lsn().unwrap();
+    primary
+        .execute(&format!("INSERT INTO applicator_rows VALUES ({id}, {})", id * 10))
+        .unwrap();
+    // Async open/replay is read-only: no group-commit worker, append, or Drop write.
+    WriteAheadLog::open(primary.storage.db(), WalSyncMode::Async)
+        .unwrap()
+        .replay_from(before)
+        .unwrap()
+        .into_iter()
+        .find_map(|entry| match entry.operation {
+            operation @ WalOperation::Insert { .. } => Some(operation),
+            _ => None,
+        })
+        .expect("SQL fixture must emit an actual Insert WAL operation")
+}
+
+fn entry(lsn: u64, operation: &WalOperation) -> WalEntry {
+    WalEntry {
+        lsn,
+        tx_id: None,
+        entry_type: WalEntryType::Insert,
+        data: bincode::serialize(operation).unwrap(),
+        checksum: 0,
+    }
+}
+
+fn applicator() -> WalApplicator {
+    WalApplicator::new(PrimaryConfig {
+        host: "127.0.0.1".to_string(),
+        port: 1, // no connection is made: these tests drive the owned queue directly
+        connect_timeout: Duration::from_secs(1),
+        use_tls: false,
+    })
+}
+
+async fn assert_terminal_gap(malformed_serialization: bool) {
+    let primary = database();
+    let standby = database();
+    let first = entry(1, &capture_insert(&primary, 1));
+    let later = entry(3, &capture_insert(&primary, 3));
+    let mut failing = entry(
+        2,
+        &WalOperation::Insert {
+            table: "applicator_rows".to_string(),
+            // This is valid serialized WAL but an invalid target key, rejected
+            // by StorageEngine's live-replay validation before mutating rows.
+            key: b"data:another_table:1".to_vec(),
+            tuple: vec![],
+        },
+    );
+    if malformed_serialization {
+        failing.data = vec![0xff];
+    }
+    let applicator = applicator();
+    // Queue all three before starting, so the successor is definitely pending
+    // when the middle entry fails rather than merely refused by a closed queue.
+    applicator.queue_entry(first).await.unwrap();
+    applicator.queue_entry(failing).await.unwrap();
+    applicator.queue_entry(later.clone()).await.unwrap();
+    let sender = applicator.get_queue_sender();
+    applicator.start_with_storage(standby.storage.clone()).await.unwrap();
+    timeout(Duration::from_secs(3), sender.closed())
+        .await
+        .expect("failure must close the incoming queue promptly");
+
+    assert_eq!(applicator.state().await, ApplicatorState::Error);
+    assert_eq!(applicator.applied_lsn().await, 1);
+    assert_eq!(applicator.lag(3).await, 2);
+    assert_eq!(applicator.stats().await, (1, 0, 1));
+    let rows = standby.storage.scan_table("applicator_rows").unwrap();
+    assert_eq!(rows.len(), 1, "a later entry must never cross the failed LSN");
+    assert_eq!(
+        rows[0].values.iter().map(ToString::to_string).collect::<Vec<_>>(),
+        ["1", "10"]
+    );
+    assert!(sender.is_closed());
+    assert!(sender.send(later.clone()).await.is_err());
+    assert!(applicator.queue_entry(later.clone()).await.is_err());
+
+    assert!(applicator.pause().await.is_err());
+    assert!(applicator.resume().await.is_err());
+    assert!(applicator.promote().await.is_err());
+    assert!(applicator.start().await.is_err());
+    assert!(applicator.start_with_storage(standby.storage.clone()).await.is_err());
+    assert!(applicator.apply(later).await.is_err());
+    applicator.stop().await.unwrap();
+    assert_eq!(
+        applicator.state().await,
+        ApplicatorState::Error,
+        "stop must preserve the failed state"
+    );
+    assert_eq!(applicator.applied_lsn().await, 1);
+    assert!(applicator.resume().await.is_err());
+    assert!(applicator.promote().await.is_err());
+}
+
+#[tokio::test]
+async fn malformed_wal_closes_queue_and_poison_is_sticky() {
+    assert_terminal_gap(true).await;
+}
+
+#[tokio::test]
+async fn storage_rejection_closes_queue_and_poison_is_sticky() {
+    assert_terminal_gap(false).await;
+}
+
+#[tokio::test]
+async fn legacy_lsn_only_methods_cannot_bypass_a_storage_worker() {
+    let primary = database();
+    let standby = database();
+    let operation = capture_insert(&primary, 1);
+    let applicator = applicator();
+    applicator.start_with_storage(standby.storage.clone()).await.unwrap();
+    assert!(applicator.apply(entry(99, &operation)).await.is_err());
+    assert!(applicator.start().await.is_err());
+    assert_eq!(applicator.applied_lsn().await, 0);
+    applicator.queue_entry(entry(1, &operation)).await.unwrap();
+    timeout(Duration::from_secs(3), async {
+        while applicator.applied_lsn().await != 1 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("storage worker should still apply valid entries");
+    assert_eq!(applicator.state().await, ApplicatorState::Streaming);
+    assert_eq!(standby.storage.scan_table("applicator_rows").unwrap().len(), 1);
+    applicator.stop().await.unwrap();
+    timeout(Duration::from_secs(3), applicator.get_queue_sender().closed())
+        .await
+        .expect("stop should close the worker queue");
+}
