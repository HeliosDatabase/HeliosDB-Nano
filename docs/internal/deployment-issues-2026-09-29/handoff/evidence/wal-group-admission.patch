+    #[test]
+    fn group_commit_encoding_failure_has_no_tail_write_or_broadcast() {
+        let (_root, db) = create_test_db();
+        db.put(b"wal:last_lsn", 3u64.to_le_bytes()).unwrap();
+        let sequence = db.latest_sequence_number();
+        let mut receivers = Vec::new();
+        let pending = [4, 5, 6]
+            .into_iter()
+            .map(|lsn| {
+                let (result_tx, result_rx) = crossbeam::channel::bounded(1);
+                receivers.push(result_rx);
+                PendingWrite {
+                    entry: WalEntry::new(lsn, WalOperation::Truncate { table: "probe".into() }),
+                    result_tx,
+                }
+            })
+            .collect();
+        let mut encoded = Vec::new();
+        flush_group_commit_batch(
+            &db,
+            pending,
+            |entry| {
+                encoded.push(entry.lsn);
+                if entry.lsn == 5 {
+                    Err(Error::storage("injected sealing failure"))
+                } else {
+                    entry.serialize()
+                }
+            },
+            |_| panic!("failed group was broadcast"),
+        );
+        assert_eq!(encoded, [4, 5]);
+        for receiver in receivers {
+            assert!(receiver
+                .recv()
+                .unwrap()
+                .unwrap_err()
+                .to_string()
+                .contains("injected sealing failure"));
+            assert!(matches!(
+                receiver.try_recv(),
+                Err(crossbeam::channel::TryRecvError::Disconnected)
+            ));
+        }
+        assert_eq!(db.latest_sequence_number(), sequence);
+        assert_eq!(db.get(b"wal:last_lsn").unwrap().unwrap(), 3u64.to_le_bytes());
+        for lsn in [4, 5, 6] {
+            assert!(db.get(format!("wal:entries:{lsn:020}")).unwrap().is_none());
+        }
+    }
+
+    #[test]
+    fn group_commit_success_is_durable_before_publication_and_one_notification() {
+        let (_root, db) = create_test_db();
+        let (tx, rx) = crossbeam::channel::bounded(1);
+        let pending = vec![PendingWrite {
+            entry: WalEntry::new(7, WalOperation::Truncate { table: "probe".into() }),
+            result_tx: tx,
+        }];
+        let mut broadcast = false;
+        flush_group_commit_batch(&db, pending, WalEntry::serialize, |pending| {
+            broadcast = true;
+            assert_eq!(pending.len(), 1);
+            assert_eq!(db.get(b"wal:last_lsn").unwrap().unwrap(), 7u64.to_le_bytes());
+            let raw = db.get(b"wal:entries:00000000000000000007").unwrap().unwrap();
+            assert_eq!(WalEntry::deserialize(&raw).unwrap().lsn, 7);
+            assert!(matches!(rx.try_recv(), Err(crossbeam::channel::TryRecvError::Empty)));
+        });
+        assert!(broadcast);
+        assert_eq!(rx.recv().unwrap().unwrap(), 7);
+        assert!(matches!(
+            rx.try_recv(),
+            Err(crossbeam::channel::TryRecvError::Disconnected)
+        ));
     }
 
