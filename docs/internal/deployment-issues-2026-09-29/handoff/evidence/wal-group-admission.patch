 struct PendingWrite {
     entry: WalEntry,
     result_tx: crossbeam::channel::Sender<Result<u64>>,
+}
+
+/// A caller's source-operation permit covers this worker until its one final
+/// notification. Never release a failed encoder's waiter and then perform DB
+/// writes or broadcasts on its behalf. Encoding failure aborts the whole group
+/// before any I/O; other callers can safely retry their ordinary operation.
+fn flush_group_commit_batch(
+    db: &DB,
+    pending: Vec<PendingWrite>,
+    mut encode: impl FnMut(&WalEntry) -> Result<Vec<u8>>,
+    committed: impl FnOnce(&[PendingWrite]),
+) {
+    if pending.is_empty() {
+        return;
+    }
+    let prepared = (|| -> Result<(WriteBatch, u64)> {
+        let mut batch = WriteBatch::default();
+        let mut last_lsn = 0u64;
+        for write in &pending {
+            let data = encode(&write.entry)?;
+            let key = format!("wal:entries:{:020}", write.entry.lsn);
+            batch.put(key.as_bytes(), &data);
+            last_lsn = last_lsn.max(write.entry.lsn);
+        }
+        batch.put(b"wal:last_lsn", last_lsn.to_le_bytes());
+        Ok((batch, last_lsn))
+    })();
+    let result = prepared.and_then(|(batch, last_lsn)| {
+        let mut options = WriteOptions::default();
+        options.set_sync(true);
+        db.write_opt(batch, &options)
+            .map_err(|error| Error::storage(format!("Group commit batch write failed: {error}")))?;
+        committed(&pending);
+        Ok(last_lsn)
+    });
+    match result {
+        Ok(last_lsn) => {
+            // All durable work and replication publication completed before
+            // the first waiter can release its foreground admission.
+            for write in pending {
+                let _ = write.result_tx.send(Ok(write.entry.lsn));
+            }
+            debug!("Group commit: successfully flushed through LSN {}", last_lsn);
+        }
+        Err(error) => {
+            let message = error.to_string();
+            for write in pending {
+                let _ = write.result_tx.send(Err(Error::storage(message.clone())));
+            }
+            error!("Group commit failed: {}", message);
+        }
+    }
 }
 
