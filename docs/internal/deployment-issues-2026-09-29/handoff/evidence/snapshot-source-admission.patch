+#[cfg(all(test, feature = "ha-tier1"))]
+#[allow(clippy::unwrap_used, clippy::expect_used)]
+mod physical_source_admission_tests {
+    use super::*;
+    use crate::replication::physical_source_coordinator::{CoordinatorError, PhysicalSourceCoordinator};
+    use std::{sync::mpsc, thread, time::Duration};
+
+    struct JoinedThread<T>(Option<thread::JoinHandle<T>>);
+    impl<T> JoinedThread<T> {
+        fn join(mut self) -> thread::Result<T> {
+            self.0.take().unwrap().join()
+        }
+    }
+    impl<T> Drop for JoinedThread<T> {
+        fn drop(&mut self) {
+            if let Some(handle) = self.0.take() {
+                let _ = handle.join();
+            }
+        }
+    }
+    fn manager(db: Arc<DB>, gc: GcConfig) -> (SnapshotManager, Arc<PhysicalSourceCoordinator>) {
+        let coordinator = Arc::new(PhysicalSourceCoordinator::new(db.clone()));
+        let mut manager = SnapshotManager::with_gc_config(db, gc);
+        manager.set_physical_source_coordinator(Some(coordinator.clone()));
+        (manager, coordinator)
+    }
+    fn writable(path: &std::path::Path) -> Arc<DB> {
+        let mut options = rocksdb::Options::default();
+        options.create_if_missing(true);
+        Arc::new(DB::open(&options, path).unwrap())
+    }
+
+    #[test]
+    fn snapshot_registration_waits_for_capture_and_publishes_complete_metadata() {
+        let root = tempfile::tempdir().unwrap();
+        let db = writable(&root.path().join("db"));
+        let (manager, coordinator) = manager(
+            db.clone(),
+            GcConfig {
+                auto_gc_enabled: false,
+                ..GcConfig::default()
+            },
+        );
+        let (entered_tx, entered_rx) = mpsc::channel();
+        let (done_tx, done_rx) = mpsc::channel();
+        // Declare the fence after the joining owner so unwind releases it before join.
+        let mut worker = JoinedThread(None);
+        let fence = coordinator.fence(Duration::from_secs(1)).unwrap();
+        worker.0 = Some(thread::spawn(move || {
+            entered_tx.send(()).unwrap();
+            let result = manager.register_snapshot_with_lsn(71, 91);
+            done_tx.send(result).unwrap();
+        }));
+        let entered = entered_rx.recv_timeout(Duration::from_secs(2));
+        let early = done_rx.recv_timeout(Duration::from_millis(40));
+        let during = db.get(b"snapshot:71").unwrap();
+        drop(fence);
+        let completed = done_rx.recv_timeout(Duration::from_secs(2));
+        let joined = worker.join();
+        assert!(entered.is_ok() && matches!(early, Err(mpsc::RecvTimeoutError::Timeout)));
+        assert!(during.is_none());
+        let metadata = completed.unwrap().unwrap();
+        assert_eq!(metadata.transaction_id, 91);
+        let stored = deserialize_snapshot_metadata(&db.get(b"snapshot:71").unwrap().unwrap()).unwrap();
+        assert_eq!((stored.timestamp, stored.transaction_id), (71, 91));
+        assert!(joined.is_ok());
+        assert!(coordinator.fence(Duration::from_secs(1)).is_ok());
+    }
+
+    #[test]
+    fn successful_versions_and_noop_materialization_leave_certification_available() {
+        let root = tempfile::tempdir().unwrap();
+        let db = writable(&root.path().join("db"));
+        let (manager, coordinator) = manager(
+            db.clone(),
+            GcConfig {
+                auto_gc_enabled: false,
+                ..GcConfig::default()
+            },
+        );
+        manager.materialize_copy_marker_row_durable("absent", 1).unwrap();
+        assert_eq!(db.latest_sequence_number(), 0);
+        manager.write_version("probe", 7, 31, b"original").unwrap();
+        let index = format!("v_idx:probe:7:{:020}", u64::MAX - 31);
+        assert_eq!(
+            db.get(b"v:probe:7:31").unwrap().as_deref(),
+            Some(b"original".as_slice())
+        );
+        assert_eq!(db.get(index).unwrap().as_deref(), Some(31u64.to_be_bytes().as_slice()));
+        manager
+            .write_data_version_and_register_snapshot(
+                b"data:probe:7",
+                b"new",
+                "probe",
+                7,
+                32,
+                b"new",
+                Some(101),
+                None,
+                false,
+            )
+            .unwrap();
+        assert_eq!(
+            manager.read_at_snapshot("probe", 7, 31).unwrap().as_deref(),
+            Some(b"original".as_slice())
+        );
+        assert_eq!(db.get(b"data:probe:7").unwrap().as_deref(), Some(b"new".as_slice()));
+        assert_eq!(manager.get_snapshot_metadata(32).unwrap().transaction_id, 101);
+        assert!(coordinator.fence(Duration::from_secs(1)).is_ok());
+    }
+
+    #[test]
+    fn swallowed_auto_gc_storage_error_revokes_certification_but_keeps_primary_admission() {
+        let root = tempfile::tempdir().unwrap();
+        let path = root.path().join("db");
+        {
+            let db = writable(&path);
+            let manager = SnapshotManager::with_gc_config(
+                db,
+                GcConfig {
+                    auto_gc_enabled: false,
+                    ..GcConfig::default()
+                },
+            );
+            manager.register_snapshot(1).unwrap();
+            manager.register_snapshot(2).unwrap();
+        }
+        // A real RocksDB read-only write failure exercises the swallowed GC path
+        // without changing permissions or injecting failures into production code.
+        let db = Arc::new(DB::open_for_read_only(&rocksdb::Options::default(), &path, false).unwrap());
+        let (manager, coordinator) = manager(
+            db.clone(),
+            GcConfig {
+                max_snapshots: 0,
+                auto_gc_enabled: true,
+                ..GcConfig::default()
+            },
+        );
+        manager.recover_snapshots().unwrap();
+        let sequence = db.latest_sequence_number();
+        let original = db.get(b"snapshot:1").unwrap();
+        let operation = coordinator.operation().unwrap();
+        let result = manager.finish_version_snapshot("probe", 7, 3, 3, 3, SnapshotMetadata::new(3, 3, 3));
+        drop(operation);
+        assert!(result.is_ok(), "legacy SQL-facing GC suppression stays unchanged");
+        assert_eq!(db.latest_sequence_number(), sequence);
+        assert_eq!(db.get(b"snapshot:1").unwrap(), original);
+        assert!(original.is_some());
+        assert_eq!(
+            manager.snapshot_count(),
+            0,
+            "GC reached its removal phase before the real storage failure"
+        );
+        assert!(matches!(
+            coordinator.fence(Duration::from_secs(1)),
+            Err(CoordinatorError::Poisoned(_))
+        ));
+        assert!(
+            coordinator.operation().is_ok(),
+            "certification poison must not disable ordinary primary admission"
+        );
+    }
+}
