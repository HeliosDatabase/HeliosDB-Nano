+#[cfg(all(test, feature = "ha-tier1", target_os = "linux"))]
+mod physical_http_insert_tests {
+    use super::*;
+    use crate::replication::{
+        history::load_or_create_primary_history,
+        physical_source_coordinator::CoordinatorError,
+    };
+    use std::{sync::Arc, time::Duration};
+
+    #[tokio::test]
+    async fn first_bad_row_keeps_certification_but_later_bad_row_marks_partial_request() {
+        let root = tempfile::tempdir().unwrap();
+        let path = root.path().join("source");
+        let mut config = crate::Config::default();
+        config.storage.path = Some(path.clone());
+        config.replication.physical.enabled = true;
+        let db = Arc::new(crate::EmbeddedDatabase::with_config(config).unwrap());
+        db.execute("CREATE TABLE phase_rows (id INT NOT NULL)").unwrap();
+        let history = load_or_create_primary_history(&path).unwrap();
+        let coordinator = db.storage.physical_source_coordinator().unwrap();
+        let state = AppState {
+            db: db.clone(),
+            query_registry: Arc::new(crate::compute::QueryRegistry::new()),
+            auth_bridge: None,
+            oauth_registry: None,
+            change_notifier: None,
+        };
+        let row = |value| std::collections::HashMap::from([("id".to_string(), value)]);
+        let bad = row(serde_json::json!(["not-an-integer"]));
+        let before = db.storage.db().latest_sequence_number();
+        let result = insert_data(
+            State(state.clone()),
+            Path(("main".into(), "phase_rows".into())),
+            Json(InsertDataRequest { rows: vec![bad.clone()], return_ids: true }),
+        ).await;
+        assert!(result.is_err());
+        assert_eq!(db.storage.db().latest_sequence_number(), before);
+        assert!(coordinator.capture_barrier(history, Duration::from_secs(1)).is_ok());
+        let result = insert_data(
+            State(state),
+            Path(("main".into(), "phase_rows".into())),
+            Json(InsertDataRequest { rows: vec![row(serde_json::json!(1)), bad], return_ids: true }),
+        ).await;
+        assert!(result.is_err());
+        assert!(db.storage.db().latest_sequence_number() > before);
+        let rows = db.query("SELECT id FROM phase_rows", &[]).unwrap();
+        assert_eq!(rows.len(), 1, "first row must have persisted before later coercion failed");
+        assert_eq!(rows[0].values[0], crate::Value::Int4(1));
+        assert!(matches!(coordinator.capture_barrier(history, Duration::from_secs(1)), Err(CoordinatorError::Poisoned(_))));
+        db.execute("INSERT INTO phase_rows VALUES (2)").unwrap();
+        assert_eq!(db.query("SELECT id FROM phase_rows", &[]).unwrap().len(), 2);
+    }
+}
