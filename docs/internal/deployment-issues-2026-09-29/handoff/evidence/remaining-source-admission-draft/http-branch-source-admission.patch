+#[cfg(all(test, feature = "ha-tier1", target_os = "linux"))]
+mod physical_source_admission_tests {
+    use super::*;
+    use crate::replication::{
+        history::load_or_create_primary_history,
+        physical_source_coordinator::{CoordinatorError, PhysicalSourceCoordinator},
+    };
+    use std::{sync::mpsc, thread, time::Duration};
+
+    fn fixture() -> (tempfile::TempDir, Arc<DB>, Arc<BranchManager>, Arc<PhysicalSourceCoordinator>, uuid::Uuid) {
+        let root = tempfile::tempdir().unwrap();
+        let mut options = rocksdb::Options::default();
+        options.create_if_missing(true);
+        let db = Arc::new(DB::open(&options, root.path().join("source")).unwrap());
+        let mut manager = BranchManager::new(db.clone(), Arc::new(RwLock::new(1))).unwrap();
+        let history = load_or_create_primary_history(db.path()).unwrap();
+        let coordinator = Arc::new(PhysicalSourceCoordinator::new(db.clone()));
+        manager.set_physical_source_coordinator(Some(coordinator.clone()));
+        (root, db, Arc::new(manager), coordinator, history)
+    }
+
+    #[test]
+    fn ordinary_branch_validation_errors_leave_source_certifiable() {
+        let (_root, db, manager, coordinator, history) = fixture();
+        manager.create_branch("existing", None, 1, BranchOptions::default()).unwrap();
+        let before = db.latest_sequence_number();
+        assert!(manager.create_branch("existing", None, 1, BranchOptions::default()).is_err());
+        assert!(manager.create_branch("missing-parent", Some("absent"), 1, BranchOptions::default()).is_err());
+        assert!(manager.drop_branch("main", false).is_err());
+        assert!(manager.drop_branch("absent", false).is_err());
+        assert!(manager.merge_branch("absent", "main", MergeStrategy::Manual).is_err());
+        assert_eq!(db.latest_sequence_number(), before);
+        assert_eq!(coordinator.capture_barrier(history, Duration::from_secs(1)).unwrap().source_sequence(), before);
+    }
+
+    #[test]
+    fn failed_branch_create_after_metadata_write_refuses_certification_only() {
+        let (_root, db, manager, coordinator, history) = fixture();
+        let children_key = encode_branch_children_key(1);
+        // Private fixture: force add_child_branch to fail AFTER metadata+registry.
+        db.put(&children_key, b"\xff").unwrap();
+        let before = db.latest_sequence_number();
+        assert!(manager.create_branch("partial", None, 1, BranchOptions::default()).is_err());
+        assert!(db.latest_sequence_number() > before, "fixture must fail after durable writes");
+        assert!(db.get(encode_branch_meta_key("partial")).unwrap().is_some());
+        assert!(matches!(coordinator.capture_barrier(history, Duration::from_secs(1)), Err(CoordinatorError::Poisoned(_))));
+        let permit = coordinator.operation().unwrap();
+        db.put(b"primary-still-writable", b"yes").unwrap();
+        drop(permit);
+        assert_eq!(db.get(&children_key).unwrap(), Some(b"\xff".to_vec()));
+    }
+
+    #[test]
+    fn branch_manager_mutation_waits_behind_a_source_capture_fence() {
+        let (_root, _db, manager, coordinator, history) = fixture();
+        let fence = coordinator.fence(Duration::from_secs(1)).unwrap();
+        let (started_tx, started_rx) = mpsc::channel();
+        let (done_tx, done_rx) = mpsc::channel();
+        let worker = thread::spawn(move || {
+            let _ = started_tx.send(());
+            let result = manager.create_branch("after-fence", None, 1, BranchOptions::default());
+            let _ = done_tx.send(result.is_ok());
+        });
+        // All blocking resources are released/reaped before assertions.
+        let started = started_rx.recv_timeout(Duration::from_secs(2));
+        let early = done_rx.recv_timeout(Duration::from_millis(30));
+        drop(fence);
+        let done = done_rx.recv_timeout(Duration::from_secs(2));
+        let joined = worker.join();
+        assert!(started.is_ok() && early.is_err());
+        assert_eq!(done.unwrap(), true);
+        assert!(joined.is_ok());
+        assert!(coordinator.capture_barrier(history, Duration::from_secs(1)).is_ok());
+    }
