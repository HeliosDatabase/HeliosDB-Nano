+#[cfg(all(test, feature = "ha-tier1", target_os = "linux"))]
+mod physical_create_table_completion_tests {
+    use super::*;
+    use crate::replication::{
+        history::load_or_create_primary_history,
+        physical_source_coordinator::{CoordinatorError, PhysicalSourceCoordinator},
+    };
+    use crate::{Column, EmbeddedDatabase};
+    use std::{sync::Arc, time::Duration};
+
+    fn fixture() -> (
+        tempfile::TempDir,
+        EmbeddedDatabase,
+        Arc<PhysicalSourceCoordinator>,
+        uuid::Uuid,
+    ) {
+        let root = tempfile::tempdir().unwrap();
+        let path = root.path().join("source");
+        let mut config = crate::Config::default();
+        config.storage.path = Some(path.clone());
+        config.replication.physical.enabled = true;
+        let db = EmbeddedDatabase::with_config(config).unwrap();
+        let history = load_or_create_primary_history(&path).unwrap();
+        let coordinator = db.storage.physical_source_coordinator().unwrap();
+        (root, db, coordinator, history)
+    }
+
+    fn schema() -> Schema {
+        Schema::new(vec![Column::new("id", DataType::Int4)])
+    }
+
+    #[test]
+    fn catalog_late_finalizer_failure_poison_is_sticky_but_ordinary_ddl_still_works() {
+        let (_root, db, coordinator, history) = fixture();
+        let catalog = db.storage.catalog();
+        let before = db.storage.db().latest_sequence_number();
+        let result = catalog.create_table_with_finalize("partial", schema(), || {
+            let mut constraints = crate::sql::TableConstraints::new();
+            constraints.add_unique(crate::sql::UniqueConstraint::new(
+                "partial_unique".into(),
+                "partial".into(),
+                vec!["id".into()],
+                false,
+            ));
+            catalog.save_table_constraints("partial", &constraints)?;
+            Err(Error::storage("owned fixture: final metadata step failed"))
+        });
+        assert!(result.unwrap_err().to_string().contains("final metadata step failed"));
+        assert!(db.storage.db().latest_sequence_number() > before);
+        assert!(db
+            .storage
+            .get(&Catalog::table_metadata_key("partial"))
+            .unwrap()
+            .is_some());
+        assert!(db
+            .storage
+            .get(&Catalog::table_constraints_key("partial"))
+            .unwrap()
+            .is_some());
+        assert!(matches!(
+            coordinator.capture_barrier(history, Duration::from_secs(1)),
+            Err(CoordinatorError::Poisoned(_))
+        ));
+        catalog.create_table("ordinary_still_works", schema()).unwrap();
+        assert!(catalog.table_exists("ordinary_still_works").unwrap());
+        assert!(matches!(
+            coordinator.capture_barrier(history, Duration::from_secs(1)),
+            Err(CoordinatorError::Poisoned(_))
+        ));
+    }
+
+    #[test]
+    fn duplicate_table_never_runs_finalizer_or_poison_certification() {
+        let (_root, db, coordinator, history) = fixture();
+        let catalog = db.storage.catalog();
+        catalog.create_table("existing", schema()).unwrap();
+        let before = db.storage.db().latest_sequence_number();
+        let called = std::cell::Cell::new(false);
+        assert!(catalog
+            .create_table_with_finalize("existing", schema(), || {
+                called.set(true);
+                Ok(())
+            })
+            .is_err());
+        assert!(!called.get());
+        assert_eq!(db.storage.db().latest_sequence_number(), before);
+        assert_eq!(
+            coordinator
+                .capture_barrier(history, Duration::from_secs(1))
+                .unwrap()
+                .source_sequence(),
+            before
+        );
+    }
+
+    #[test]
+    fn sql_partition_metadata_failure_after_schema_creation_refuses_certification() {
+        let (_root, db, coordinator, history) = fixture();
+        db.execute("CREATE TABLE phase_parent (id INT NOT NULL) PARTITION BY RANGE (id)")
+            .unwrap();
+        // Force the real SQL finalizer to fail while decoding the parent's
+        // child registry, after Catalog has persisted the child's schema.
+        db.storage
+            .put(&Catalog::partition_children_key("phase_parent"), b"\xff")
+            .unwrap();
+        let before = db.storage.db().latest_sequence_number();
+        coordinator.capture_barrier(history, Duration::from_secs(1)).unwrap();
+        let error = db
+            .execute("CREATE TABLE phase_child PARTITION OF phase_parent FOR VALUES FROM (0) TO (100)")
+            .unwrap_err();
+        assert!(error.to_string().contains("partition-child deserialize"), "{error}");
+        assert!(db.storage.db().latest_sequence_number() > before);
+        assert!(db
+            .storage
+            .get(&Catalog::table_metadata_key("phase_child"))
+            .unwrap()
+            .is_some());
+        assert!(matches!(
+            coordinator.capture_barrier(history, Duration::from_secs(1)),
+            Err(CoordinatorError::Poisoned(_))
+        ));
+    }
+
+    #[test]
+    fn sql_success_constraints_and_prewrite_refusals_preserve_certification() {
+        let (_root, db, coordinator, history) = fixture();
+        db.execute("CREATE TABLE complete_phase (id INT PRIMARY KEY, code INT UNIQUE)")
+            .unwrap();
+        let constraints = db.storage.catalog().load_table_constraints("complete_phase").unwrap();
+        assert!(constraints
+            .unique_constraints
+            .iter()
+            .any(|constraint| constraint.is_primary_key && constraint.columns == vec!["id".to_string()]));
+        assert!(constraints
+            .unique_constraints
+            .iter()
+            .any(|constraint| !constraint.is_primary_key && constraint.columns == vec!["code".to_string()]));
+        coordinator.capture_barrier(history, Duration::from_secs(1)).unwrap();
+        let before = db.storage.db().latest_sequence_number();
+        assert!(db.execute("CREATE TABLE complete_phase (other INT)").is_err());
+        db.execute("CREATE TABLE IF NOT EXISTS complete_phase (other INT)")
+            .unwrap();
+        assert!(db
+            .execute("CREATE TABLE missing_fk_phase (id INT REFERENCES no_such_parent(id))")
+            .is_err());
+        assert!(!db.storage.catalog().table_exists("missing_fk_phase").unwrap());
+        assert_eq!(db.storage.db().latest_sequence_number(), before);
+        coordinator.capture_barrier(history, Duration::from_secs(1)).unwrap();
+    }
