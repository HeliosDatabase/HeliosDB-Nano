+    /// Move only a connection-owned idle session between immutable generations.
+    /// Caller exclusively owns the connection and must retain both ServingLease
+    /// values through the transfer; no statement/portal may still use the old DB.
+    /// False means engine-owned state pins the old generation; nothing is lost.
+    #[cfg(feature = "ha-tier1")]
+    pub(crate) fn try_transfer_idle_physical_session(
+        &self,
+        target: &Self,
+        session_id: crate::session::SessionId,
+    ) -> Result<bool> {
+        if std::ptr::eq(self, target) {
+            return Ok(true);
+        }
+        if self.session_transactions.contains_key(&session_id)
+            || self.session_art_undo.contains_key(&session_id)
+            || self.session_notices.contains_key(&session_id)
+            || target.session_transactions.contains_key(&session_id)
+            || target.session_art_undo.contains_key(&session_id)
+            || target.session_notices.contains_key(&session_id)
+        {
+            return Ok(false);
+        }
+        let session = self.session_manager.get_session(session_id)?;
+        let needs_schema_hint = {
+            let state = session.read();
+            if state.active_txn.is_some() || state.scoped.has_tenant() || state.scoped.holds_temp_tables() {
+                return Ok(false);
+            }
+            state.current_schema.is_some() || !state.search_path.is_empty()
+        };
+        // Conservative true on a subsequent failed transfer is harmless. Set it
+        // before publishing the session into the target manager: fast paths must
+        // never miss this connection's preserved search_path.
+        if needs_schema_hint {
+            target
+                .any_session_schema_active
+                .store(true, std::sync::atomic::Ordering::Release);
+        }
+        self.session_manager
+            .transfer_idle_generation_session(&target.session_manager, session_id)?;
+        Ok(true)
+    }
