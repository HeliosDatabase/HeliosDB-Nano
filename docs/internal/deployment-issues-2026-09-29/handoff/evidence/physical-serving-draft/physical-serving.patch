+        // publication/retirement lock. No request can acquire a retired handle.
+        let mut pending = std::mem::take(&mut *lock(&self.retired));
+        let mut pinned = Vec::new();
+        for mut retired in pending.drain(..) {
+            if retired.ready() {
+                retired.reclaim();
+            } else {
+                pinned.push(retired);
+            }
+        }
+        lock(&self.retired).extend(pinned);
+    }
+}
+struct Generation {
+    database: Option<Arc<EmbeddedDatabase>>,
+    raw: Option<Arc<rocksdb::DB>>,
+    directory: Option<tempfile::TempDir>,
+    budget: Option<OwnedSemaphorePermit>,
+    owner: Weak<Inner>,
+    cut: VerifiedCommittedCut,
+    report: PhysicalSnapshotHydrationReport,
+    bytes: u64,
+}
+impl Drop for Generation {
+    fn drop(&mut self) {
+        let retired = Retired {
+            database: self.database.take(),
+            raw: self.raw.take(),
+            directory: self.directory.take(),
+            budget: self.budget.take(),
+        };
+        if let Some(owner) = self.owner.upgrade() {
+            lock(&owner.retired).push(retired);
+        }
+        // Otherwise Retired::drop either safely destroys or conservatively
+        // retains the directory; it never blindly runs TempDir behind an Arc.
+    }
+}
+#[derive(Clone)]
+pub struct ServingLease {
+    generation: Arc<Generation>,
+}
+impl ServingLease {
+    pub fn database(&self) -> &EmbeddedDatabase {
+        self.generation.database.as_ref().expect("live generation database")
+    }
+    /// Internal PG integration must retain this lease through every clone/use.
+    /// An accidental escape is still safe: retirement detects and pins it.
+    pub(crate) fn database_arc(&self) -> Arc<EmbeddedDatabase> {
+        self.generation
+            .database
+            .as_ref()
+            .expect("live generation database")
+            .clone()
+    }
+    pub fn history(&self) -> Uuid {
+        self.generation.cut.history()
+    }
+    pub fn source_sequence(&self) -> u64 {
+        self.generation.cut.source_sequence()
+    }
+    pub fn report(&self) -> &PhysicalSnapshotHydrationReport {
+        &self.generation.report
+    }
+    pub fn image_bytes(&self) -> u64 {
+        self.generation.bytes
+    }
+}
+pub(crate) struct GenerationReservation {
+    owner: Arc<Inner>,
+    budget: OwnedSemaphorePermit,
+    _building: OwnedSemaphorePermit,
+    cut: VerifiedCommittedCut,
+}
+impl GenerationReservation {
+    pub(crate) fn cut(&self) -> &VerifiedCommittedCut {
+        &self.cut
+    }
+}
+// Field order is deliberate: canceled/unobserved replies destroy the copied
+// directory before returning its resident/build capacity to the shared budget.
+pub(crate) struct PreparedGeneration {
+    pub(crate) image: SealedPhysicalImage,
+    pub(crate) reservation: GenerationReservation,
+}
+type Job = PreparedGeneration;
+
+/// One joined hydration/reclamation worker. Resident capacity includes current,
+/// in-progress, retired request leases and escaped DB/storage references.
+pub struct ServingGenerations {
+    inner: Arc<Inner>,
+    parent: PathBuf,
+    limits: TransferLimits,
+    sender: Mutex<Option<mpsc::SyncSender<Job>>>,
+    worker: Mutex<Option<thread::JoinHandle<()>>>,
+}
+impl ServingGenerations {
+    pub fn new(parent: PathBuf, config: Config, limits: TransferLimits, max_resident: usize) -> Result<Arc<Self>> {
+        if !(2..=16).contains(&max_resident) || config.storage.memory_only {
+            return Err("serving generation requires persistent config and 2..=16 resident slots".into());
+        }
+        let metadata = std::fs::symlink_metadata(&parent).map_err(|e| e.to_string())?;
+        if !metadata.is_dir() || metadata.file_type().is_symlink() {
+            return Err("generation parent must be an existing real directory".into());
+        }
+        let inner = Arc::new(Inner {
+            current: Mutex::new(None),
+            retired: Mutex::new(Vec::new()),
+            closed: AtomicBool::new(false),
+            last_error: Mutex::new(None),
+            resident: Arc::new(Semaphore::new(max_resident)),
+            building: Arc::new(Semaphore::new(1)),
+            capacity: max_resident,
+        });
+        let (tx, rx) = mpsc::sync_channel::<Job>(1);
+        let state = inner.clone();
+        let worker = thread::Builder::new()
+            .name("nano-serving-generation".into())
+            .spawn(move || {
+                loop {
+                    state.reap();
+                    match rx.recv_timeout(Duration::from_millis(100)) {
+                        Ok(job) => {
+                            if state.closed.load(Ordering::Acquire) {
+                                drop(job);
+                                continue;
+                            }
+                            match hydrate(job, &config, limits) {
+                                Ok(generation) => {
+                                    let mut current = lock(&state.current);
+                                    if state.closed.load(Ordering::Acquire) {
+                                        drop(current);
+                                        drop(generation);
+                                        continue;
+                                    }
+                                    if current.as_ref().is_some_and(|old| {
+                                        old.cut.history() != generation.cut.history()
+                                            || old.cut.source_sequence() >= generation.cut.source_sequence()
+                                    }) {
+                                        drop(current);
+                                        state.error("refused regressing or different-history serving generation");
+                                        drop(generation);
+                                        continue;
+                                    }
+                                    let old = current.replace(Arc::new(generation));
+                                    drop(current);
+                                    drop(old);
+                                }
+                                Err(error) => state.error(error),
+                            }
+                        }
+                        Err(mpsc::RecvTimeoutError::Timeout) => {}
+                        Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                    }
+                }
+                state.reap();
+            })
+            .map_err(|e| e.to_string())?;
+        Ok(Arc::new(Self {
+            inner,
+            parent,
+            limits,
+            sender: Mutex::new(Some(tx)),
+            worker: Mutex::new(Some(worker)),
+        }))
+    }
+    pub fn lease(&self) -> Option<ServingLease> {
+        let current = lock(&self.inner.current);
+        if self.inner.closed.load(Ordering::Acquire) {
+            return None;
+        }
+        current.as_ref().map(|generation| ServingLease {
+            generation: generation.clone(),
+        })
+    }
+    pub fn last_error(&self) -> Option<String> {
+        lock(&self.inner.last_error).clone()
+    }
+    pub(crate) fn parent(&self) -> &Path {
+        &self.parent
+    }
+    pub(crate) fn limits(&self) -> TransferLimits {
+        self.limits
+    }
+    pub(crate) fn note_failure(&self, error: impl Into<String>) {
+        self.inner.error(error);
+    }
+    pub(crate) fn reserve(&self, cut: &VerifiedCommittedCut) -> Result<Option<GenerationReservation>> {
+        if self.inner.closed.load(Ordering::Acquire) {
+            return Err("serving generation owner closed".into());
+        }
+        let current = lock(&self.inner.current);
+        if let Some(current) = current.as_ref() {
+            if current.cut.history() != cut.history() {
+                return Err("serving history cannot change".into());
+            }
+            if current.cut.source_sequence() >= cut.source_sequence() {
+                return Ok(None);
+            }
+        }
+        drop(current);
+        let Ok(building) = self.inner.building.clone().try_acquire_owned() else {
+            return Ok(None);
+        };
+        let Ok(budget) = self.inner.resident.clone().try_acquire_owned() else {
+            return Ok(None);
+        };
+        Ok(Some(GenerationReservation {
+            owner: self.inner.clone(),
+            budget,
+            _building: building,
+            cut: cut.clone(),
+        }))
+    }
+    pub(crate) fn submit(&self, prepared: PreparedGeneration) -> Result<()> {
+        if !Arc::ptr_eq(&prepared.reservation.owner, &self.inner) {
+            return Err("generation reservation belongs to another owner".into());
+        }
+        let sender = lock(&self.sender);
+        if self.inner.closed.load(Ordering::Acquire) {
+            return Err("serving generation owner closed".into());
+        }
+        sender
+            .as_ref()
+            .ok_or("serving generation worker closed")?
+            .try_send(prepared)
+            .map_err(|e| e.to_string())
+    }
+    /// Stop publication and join the actual worker. Caller first stops/joins PG
+    /// requests. Pinned references cause an explicit error and retained images;
+    /// reap_retired can finish cleanup after those references have been released.
+    pub fn close_and_join(&self) -> Result<()> {
+        self.inner.closed.store(true, Ordering::Release);
+        lock(&self.sender).take();
+        if let Some(worker) = lock(&self.worker).take() {
+            worker
+                .join()
+                .map_err(|_| "serving generation worker panicked".to_string())?;
+        }
+        let current = lock(&self.inner.current).take();
+        drop(current);
+        self.reap_retired()
+    }
+    pub fn reap_retired(&self) -> Result<()> {
+        self.inner.reap();
+        if !lock(&self.inner.retired).is_empty() || self.inner.resident.available_permits() != self.inner.capacity {
+            return Err(
+                "serving generations remain pinned by request/database references; directories retained".into(),
+            );
+        }
+        Ok(())
+    }
+}
+impl Drop for ServingGenerations {
+    fn drop(&mut self) {
+        if let Err(error) = self.close_and_join() {
+            tracing::error!(%error,"serving generation shutdown retained resources");
+        }
+    }
+}
+fn hydrate(job: Job, config: &Config, limits: TransferLimits) -> Result<Generation> {
+    // Keep image-before-reservation field ordering intact across every fallible
+    // operation. Failed image cleanup must finish before capacity is released.
+    if job.image.cursor.history() != job.reservation.cut.history()
+        || job.image.cursor.source_sequence() != job.reservation.cut.source_sequence()
+    {
+        return Err("copied serving image differs from certified cut".into());
+    }
+    let mut config = config.clone();
+    config.storage.path = Some(job.image.path.clone());
+    config.storage.memory_only = false;
+    let hydrated = EmbeddedDatabase::open_physical_snapshot(config).map_err(|e| e.to_string())?;
+    let raw = hydrated.database.storage.db();
+    // All fallible validation/hydration has succeeded. Transfer ownership into
+    // the retired-reference-aware generation without an intervening await.
+    let PreparedGeneration { image, reservation } = job;
+    let GenerationReservation {
+        owner,
+        budget,
+        _building,
+        cut,
+    } = reservation;
+    let mut generation = Generation {
+        database: Some(Arc::new(hydrated.database)),
+        raw: Some(raw),
+        directory: Some(image.lease),
+        budget: Some(budget),
+        owner: Arc::downgrade(&owner),
+        cut,
+        report: hydrated.report,
+        bytes: image.total_bytes,
+    };
+    // The sentinel-aware owner is installed before this fallible final census:
+    // an error queues DB closure/image cleanup while retaining resident capacity.
+    generation.bytes = census_image(
+        generation
+            .directory
+            .as_ref()
+            .expect("owned generation directory")
+            .path()
+            .join("database")
+            .as_path(),
+        limits,
+    )?;
+    drop(_building);
+    Ok(generation)
+}
+
+fn census_image(path: &Path, limits: TransferLimits) -> Result<u64> {
+    let mut count = 0_usize;
+    let mut bytes = 0_u64;
+    for entry in std::fs::read_dir(path).map_err(|e| e.to_string())? {
+        let entry = entry.map_err(|e| e.to_string())?;
+        let metadata = std::fs::symlink_metadata(entry.path()).map_err(|e| e.to_string())?;
+        if !metadata.is_file() || metadata.file_type().is_symlink() || metadata.len() > limits.max_file_bytes {
+            return Err("serving generation contains unsupported/oversized file".into());
+        }
+        count += 1;
+        bytes = bytes
+            .checked_add(metadata.len())
+            .ok_or("serving generation size overflow")?;
+        if count > limits.max_files || bytes > limits.max_total_bytes {
+            return Err("hydrated serving generation exceeds file/byte limits, including diagnostics".into());
+        }
+    }
+    Ok(bytes)
+}
+
+#[cfg(test)]
+mod retirement_tests {
+    use super::*;
+    #[test]
+    fn retirement_atomically_excludes_weak_upgrade_before_directory_cleanup() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().to_path_buf();
+        let mut options = rocksdb::Options::default();
+        options.create_if_missing(true);
+        let raw = Arc::new(rocksdb::DB::open(&options, path.join("database")).unwrap());
+        let weak = Arc::downgrade(&raw);
+        let escaped = weak.upgrade().unwrap();
+        let capacity = Arc::new(Semaphore::new(1));
+        let budget = capacity.clone().try_acquire_owned().unwrap();
+        let mut retired = Retired {
+            database: None,
+            raw: Some(raw),
+            directory: Some(directory),
+            budget: Some(budget),
+        };
+        assert!(!retired.ready());
+        assert!(path.exists());
+        assert_eq!(capacity.available_permits(), 0);
+        drop(escaped);
+        assert!(retired.ready());
+        assert!(weak.upgrade().is_none());
+        retired.reclaim();
+        assert!(!path.exists());
+        assert_eq!(capacity.available_permits(), 1);
+    }
+    #[test]
+    fn publication_census_counts_marker_and_diagnostic_files() {
+        let root = tempfile::tempdir().unwrap();
+        std::fs::write(root.path().join("000001.sst"), b"data").unwrap();
+        std::fs::write(root.path().join("NANO-PHYSICAL-REPLICA.json"), b"marker").unwrap();
+        std::fs::write(root.path().join("LOG"), b"diagnostic").unwrap();
+        let mut limits = TransferLimits::default();
+        limits.max_total_bytes = 20;
+        limits.max_file_bytes = 20;
+        assert_eq!(census_image(root.path(), limits).unwrap(), 20);
+        limits.max_total_bytes = 19;
+        assert!(census_image(root.path(), limits).is_err());
+        limits.max_total_bytes = 20;
+        limits.max_files = 2;
+        assert!(census_image(root.path(), limits).is_err());
+    }
+}
