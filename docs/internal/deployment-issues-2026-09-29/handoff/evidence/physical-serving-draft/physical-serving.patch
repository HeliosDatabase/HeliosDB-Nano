+        let bytes = format!("{}\n", owner.manifest.storage_identity).into_bytes();
+        files += 1;
+        total_bytes = total_bytes
+            .checked_add(bytes.len() as u64)
+            .ok_or_else(|| invalid("serving identity size overflow"))?;
+        if files > limits.max_files
+            || bytes.len() as u64 > limits.max_file_bytes
+            || total_bytes > limits.max_total_bytes
+        {
+            return Err(invalid("serving identity exceeds image limits"));
+        }
+        create_file(&path.join("IDENTITY"), &bytes)?;
+    }
+    if identity(&path)? != owner.manifest.storage_identity {
+        return Err(invalid("serving copy identity mismatch"));
+    }
