+type Result<T> = std::result::Result<T, String>;
+fn lock<T>(value: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    value.lock().unwrap_or_else(|p| p.into_inner())
+}
+
+/// Always drop database owners before attempting to reclaim their directory.
+/// A raw/storage Arc escape pins both the directory and its resident budget.
+struct Retired {
+    database: Option<Arc<EmbeddedDatabase>>,
+    raw: Option<Arc<rocksdb::DB>>,
+    directory: Option<tempfile::TempDir>,
+    budget: Option<OwnedSemaphorePermit>,
+}
+impl Retired {
+    fn ready(&mut self) -> bool {
+        // Atomically exclude Weak upgrades. A count-then-drop check can race an
+        // escaped Weak<DB>, deleting files behind a newly upgraded live owner.
+        if let Some(database) = self.database.take() {
+            match Arc::try_unwrap(database) {
+                Ok(database) => drop(database),
+                Err(database) => {
+                    self.database = Some(database);
+                    return false;
+                }
+            }
+        }
+        if let Some(raw) = self.raw.take() {
+            match Arc::try_unwrap(raw) {
+                Ok(raw) => drop(raw),
+                Err(raw) => {
+                    self.raw = Some(raw);
+                    return false;
+                }
+            }
+        }
+        true
+    }
+    fn reclaim(mut self) {
+        self.raw.take();
+        self.directory.take();
+        self.budget.take();
+    }
+}
+impl Drop for Retired {
+    fn drop(&mut self) {
+        // Even an unexpected owner unwind cannot delete behind a live DB Arc.
+        if !self.ready() {
+            if let Some(directory) = self.directory.take() {
+                let path = directory.keep();
+                tracing::error!(path=%path.display(),"retaining serving generation directory behind escaped database references");
+            }
+        }
+        self.database.take();
+        self.raw.take();
+    }
+}
