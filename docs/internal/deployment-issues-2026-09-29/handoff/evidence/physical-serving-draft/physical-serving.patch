+fn copy_serving_image(
+    owner: &StageOwner,
+    replica: &mut StagedPhysicalReplica,
+    parent: &Path,
+    limits: TransferLimits,
+) -> Result<SealedPhysicalImage> {
+    limits.validate()?;
+    let parent = OwnedDirectory::capture(parent)?;
+    refuse_database_ancestors(&parent.path)?;
+    let scratch = tempfile::Builder::new()
+        .prefix("nano-generation-cut-")
+        .tempdir_in(&parent.path)?;
+    let checkpoint = scratch.path().join("checkpoint");
+    let expected = replica.cursor().clone();
+    replica.checkpoint_for_generation(&checkpoint)?;
+    let checkpoint_owner = OwnedDirectory::capture(&checkpoint)?;
+    let lease = tempfile::Builder::new()
+        .prefix("nano-serving-generation-")
+        .tempdir_in(&parent.path)?;
+    let path = lease.path().join("database");
+    fs::create_dir(&path)?;
+    let mut total_bytes = 0_u64;
+    let mut files = 0_usize;
+    for entry in fs::read_dir(&checkpoint)? {
+        let entry = entry?;
+        let name = entry
+            .file_name()
+            .into_string()
+            .map_err(|_| invalid("non-UTF8 serving checkpoint file"))?;
+        if name == "LOCK" || name == "LOG" || name.starts_with("LOG.old.") {
+            continue;
+        }
+        if !valid_file_name(&name) {
+            return Err(invalid("unexpected serving checkpoint file"));
+        }
+        let metadata = fs::symlink_metadata(entry.path())?;
+        valid_regular(&metadata, limits.max_file_bytes, false)?;
+        files += 1;
+        total_bytes = total_bytes
+            .checked_add(metadata.len())
+            .ok_or_else(|| invalid("serving image size overflow"))?;
+        if files > limits.max_files || total_bytes > limits.max_total_bytes {
+            return Err(invalid("serving image exceeds transfer limits"));
+        }
+        let (before_hash, before) = fingerprint_file(&entry.path(), metadata.len(), false)?;
+        let mut input = open_regular(&entry.path(), metadata.len(), false, false)?;
+        let mut output = fs::OpenOptions::new()
+            .create_new(true)
+            .write(true)
+            .open(path.join(&name))?;
+        let copied = std::io::copy(&mut input.take(metadata.len() + 1), &mut output)?;
+        if copied != metadata.len() {
+            return Err(invalid("serving file changed while copying"));
+        }
+        output.sync_all()?;
+        drop(output);
+        let (copy_hash, _) = fingerprint_file(&path.join(&name), copied, true)?;
+        let after = fs::symlink_metadata(entry.path())?;
