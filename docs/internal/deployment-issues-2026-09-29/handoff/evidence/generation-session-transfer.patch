+    /// Transfer one exclusively owned idle wire session between immutable
+    /// physical generations. Caller must rule out active statements, transaction
+    /// slots, tenant bindings, temporary relations and engine-owned notices.
+    /// Keeps the session/backend identity and every session setting intact.
+    /// Never hold two managers' DashMap shard locks at the same time.
+    pub(crate) fn transfer_idle_generation_session(&self, target: &Self, id: SessionId) -> Result<()> {
+        if std::ptr::eq(self, target) {
+            return Ok(());
+        }
+        let (_, session) = self
+            .sessions
+            .remove(&id)
+            .ok_or_else(|| Error::Generic(format!("Session {:?} not found", id)))?;
+        let result = (|| {
+            let state = session.write();
+            if state.active_txn.is_some() {
+                return Err(Error::transaction(
+                    "cannot move an active transaction between physical generations",
+                ));
+            }
+            match target.sessions.entry(id) {
+                dashmap::mapref::entry::Entry::Occupied(_) => {
+                    Err(Error::Generic("target generation already owns session identity".into()))
+                }
+                dashmap::mapref::entry::Entry::Vacant(entry) => {
+                    if !state
+                        .scoped
+                        .rebind_idle_engine(self.engine_instance, target.engine_instance)
+                    {
+                        return Err(Error::Generic(
+                            "physical generation session has a different engine owner".into(),
+                        ));
+                    }
+                    entry.insert(Arc::clone(&session));
+                    Ok(())
+                }
+            }
+        })();
+        if result.is_err() {
+            self.sessions.insert(id, session);
+        }
+        result
+    }
