+#[cfg(test)]
+mod physical_generation_transfer_tests {
+    use super::*;
+    #[test]
+    fn idle_transfer_preserves_identity_settings_and_rebinds_activity_owner() {
+        let first = SessionManager::new_for_engine(91001);
+        let next = SessionManager::new_for_engine(91002);
+        let user = User::new_passwordless("generation-reader");
+        let id = first.create_session(&user, IsolationLevel::RepeatableRead).unwrap();
+        let session = first.get_session(id).unwrap();
+        let scoped = session.read().scoped.clone();
+        {
+            let mut state = session.write();
+            state.current_schema = Some("reader_schema".into());
+            state.search_path = vec!["reader_schema".into(), "public".into()];
+            state.idle_session_timeout_ms = Some(1234);
+            state.scoped.set_application_name("same connection");
+            state.scoped.note_lastval(42);
+        }
+        first.transfer_idle_generation_session(&next, id).unwrap();
+        assert!(first.get_session(id).is_err());
+        let moved = next.get_session(id).unwrap();
+        assert!(Arc::ptr_eq(&session, &moved));
+        let state = moved.read();
+        assert_eq!(state.login_user.as_deref(), Some("generation-reader"));
+        assert_eq!(state.current_schema.as_deref(), Some("reader_schema"));
+        assert_eq!(state.search_path, ["reader_schema", "public"]);
+        assert_eq!(state.idle_session_timeout_ms, Some(1234));
+        assert!(Arc::ptr_eq(&scoped, &state.scoped));
+        assert_eq!(state.scoped.engine_instance(), 91002);
+        assert_eq!(state.scoped.application_name(), "same connection");
+        assert_eq!(state.scoped.lastval(), Some(42));
+    }
+    #[test]
+    fn active_or_conflicting_session_transfer_preserves_original_owner() {
+        let first = SessionManager::new_for_engine(92001);
+        let next = SessionManager::new_for_engine(92002);
+        let user = User::new_passwordless("reader");
+        let id = first.create_session(&user, IsolationLevel::ReadCommitted).unwrap();
+        let session = first.get_session(id).unwrap();
+        session.write().active_txn = Some(7);
+        assert!(first.transfer_idle_generation_session(&next, id).is_err());
+        assert!(first.get_session(id).is_ok() && next.get_session(id).is_err());
+        assert_eq!(session.read().scoped.engine_instance(), 92001);
+        session.write().active_txn = None;
+        // A corrupt target collision must not overwrite either registered handle.
+        let target_id = next.create_session(&user, IsolationLevel::ReadCommitted).unwrap();
+        let target_handle = next.get_session(target_id).unwrap();
+        next.sessions.insert(id, target_handle.clone());
+        assert!(first.transfer_idle_generation_session(&next, id).is_err());
+        assert!(Arc::ptr_eq(&next.get_session(id).unwrap(), &target_handle));
+        assert!(Arc::ptr_eq(&first.get_session(id).unwrap(), &session));
+        assert_eq!(session.read().scoped.engine_instance(), 92001);
+    }
+}
