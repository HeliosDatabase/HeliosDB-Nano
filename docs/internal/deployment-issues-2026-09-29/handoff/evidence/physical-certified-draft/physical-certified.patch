+    async fn wait_committed(
+        run: &mut Running<'_>,
+        progress: &mut watch::Receiver<ReceiverStatus>,
+        path: &std::path::Path,
+        sequence: u64,
+    ) -> VerifiedCommittedCut {
+        let deadline = tokio::time::Instant::now() + Duration::from_secs(30);
+        loop {
+            if let ReceiverStatus::CommittedCut { path: actual, cut } = &*progress.borrow_and_update() {
+                if actual == path && cut.source_sequence() >= sequence {
+                    return cut.clone();
+                }
+            }
+            tokio::select! {
+                result=run.as_mut()=>panic!("certified receiver stopped early: {result:?}"),
+                changed=progress.changed()=>changed.expect("certified progress closed"),
+                _=tokio::time::sleep_until(deadline)=>panic!("certified receiver deadline"),
