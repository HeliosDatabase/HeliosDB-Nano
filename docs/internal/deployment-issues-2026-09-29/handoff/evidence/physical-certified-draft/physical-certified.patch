+/// A completed certified wire interval, bound to the exact live receiver owner
+/// and durable cursor. This is NOT a serving-generation/readiness token. A future
+/// worker-owned snapshot command must recheck matches_position before copying;
+/// later apply makes this cut stale. Private fields prohibit minting from raw
+/// CaughtUp statuses or a caller-provided sequence integer.
+#[derive(Clone, Debug)]
+pub struct VerifiedCommittedCut {
+    receiver_owner: Uuid,
+    source_session: Uuid,
+    cursor: PhysicalCursor,
+}
+impl VerifiedCommittedCut {
+    pub fn history(&self) -> Uuid {
+        self.cursor.history()
+    }
+    pub fn source_sequence(&self) -> u64 {
+        self.cursor.source_sequence()
+    }
+    pub fn source_session(&self) -> Uuid {
+        self.source_session
+    }
+    pub(crate) fn matches_position(&self, receiver_owner: Uuid, cursor: &PhysicalCursor) -> bool {
+        self.receiver_owner == receiver_owner && self.cursor == *cursor
+    }
+}
+fn verified_committed_cut(
+    owner: Uuid,
+    info: &SourceSessionInfo,
+    summary: PollSummary,
+    durable: &PhysicalCursor,
+) -> Result<VerifiedCommittedCut> {
+    if owner.is_nil()
+        || !info.certified()
+        || info.session_id().is_nil()
+        || info.history() != durable.history()
+        || summary.through != summary.durable_barrier
+        || summary.through != durable.source_sequence()
+        || summary.durable_barrier < info.initial_barrier()
+    {
+        return Err(storage(
+            "completed certified source interval does not match durable receiver",
+        ));
+    }
+    Ok(VerifiedCommittedCut {
+        receiver_owner: owner,
+        source_session: info.session_id(),
+        cursor: durable.clone(),
+    })
+}
